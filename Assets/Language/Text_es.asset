      m_Items: []
  - m_Id: 41385915691048990
    m_Localized: "Inflige 16(\xB12) de da\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048991
    m_Localized: "Yongrin \u2160"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048992
    m_Localized: "Comienzas con 1 Rage al inicio de la expedici\xF3n."
