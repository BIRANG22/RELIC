      m_Items: []
  - m_Id: 41385915691048988
    m_Localized: Mueve 1 o 2 espacios.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048989
    m_Localized: "Corre e inflige da\xF1o al personaje con el que choca."
