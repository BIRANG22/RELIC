    m_Metadata:
      m_Items: []
  - m_Id: 1417690215956171328
    m_Localized: "Tira 12 o m\xE1s\n\xC9xito: obt\xE9n un Artefacto \xE9pico aleatorio\nFallo:
      pierde 5 PV"
    m_Metadata:
      m_Items: []
  - m_Id: 5296381621326956345
    m_Localized: Finalizar el evento
    m_Metadata:
      m_Items: []
  - m_Id: 5784428132370024697
    m_Localized: "Tira 6 o m\xE1s\nObt\xE9n 25 de Dustium rojo"
    m_Metadata:
      m_Items: []
  - m_Id: 7282873809406718105
    m_Localized: Finalizar el evento
    m_Metadata:
      m_Items: []
  - m_Id: 520187140604704921
    m_Localized: "Tira 8 o m\xE1s\nObt\xE9n 30 de Dustium rojo"
    m_Metadata:
      m_Items: []
  - m_Id: 8278174541721857739
    m_Localized: Finalizar el evento
    m_Metadata:
      m_Items: []
  - m_Id: 1602478198363195788
