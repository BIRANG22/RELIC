    m_Metadata:
      m_Items: []
  - m_Id: 10999245267542017
    m_Localized: "La situaci\xF3n en la zona de erosi\xF3n es peor de lo previsto.\nTengan
      mucho cuidado durante la exploraci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 10999245267542018
