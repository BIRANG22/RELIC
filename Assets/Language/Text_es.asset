    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992015
    m_Localized: "Mu\xF1eca Fantasma"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992016
    m_Localized: "Los Recuerdos de debilitaci\xF3n cuestan {ValueRate1} m\xE1s de
