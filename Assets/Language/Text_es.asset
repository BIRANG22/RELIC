      m_Items: []
  - m_Id: 41387432259101013
    m_Localized: Te aplicas {E_Blindside} {ValueRate1}.
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101015
    m_Localized: "Avanza {ValueRate1} casillas y despu\xE9s inflige {E_Strike} {ValueRate2}."
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101017
    m_Localized: "Inflige {E_Strike} {ValueRate1} y despu\xE9s retrocede {ValueRate2}
      casillas."
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101019
    m_Localized: Te aplicas {E_Boost} {ValueRate1}.
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101021
    m_Localized: '{E_Bleed} {ValueRate1} {E_Weaken} {ValueRate2}'
