      m_Items: []
  - m_Id: 17531528627626079
    m_Localized: "Activaci\xF3n inmediata del veneno"
    m_Metadata:
      m_Items: []
  - m_Id: 17531528627626080
    m_Localized: Al aplicar veneno por el valor indicado, activa inmediatamente una
      vez su efecto.
