      m_Items: []
  - m_Id: 41387432259101007
    m_Localized: '{E_Lifesteal} {ValueRate1} {E_Boost} {ValueRate2}'
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101009
    m_Localized: Carga y alcanza a los enemigos con los que chocas {E_Strike} {E_ArmorStrike}
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101011
    m_Localized: "{E_Strike} {ValueRate1} / Al matar, aumenta permanentemente el
      da\xF1o en {ValueRate2}"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101013
    m_Localized: Te aplicas {E_Blindside} {ValueRate1}.
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101015
    m_Localized: "Avanza {ValueRate1} casillas y despu\xE9s inflige {E_Strike} {ValueRate2}."
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101017
    m_Localized: "Inflige {E_Strike} {ValueRate1} y despu\xE9s retrocede {ValueRate2}
      casillas."
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101019
    m_Localized: Te aplicas {E_Boost} {ValueRate1}.
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101021
    m_Localized: '{E_Bleed} {ValueRate1} {E_Weaken} {ValueRate2}'
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101026
    m_Localized: "Estocada sangu\xEDnea"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101027
    m_Localized: "Inflige {E_Pierce} {ValueRate1}. Si impacta al alcance m\xE1ximo,
      aplica {E_Bleed} {ValueRate2}."
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259101029
    m_Localized: "Inflige {E_Strike} {ValueRate1} en la posici\xF3n de un enemigo
