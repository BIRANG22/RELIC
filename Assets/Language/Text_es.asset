    m_Localized: "Obt\xE9n un Artefacto aleatorio de calidad Com\xFAn a Rara"
    m_Metadata:
      m_Items: []
  - m_Id: 5085024260722569838
    m_Localized: "Reduce la Erosi\xF3n en 15"
    m_Metadata:
      m_Items: []
  - m_Id: 1219549357382717807
    m_Localized: Restaura 10 PV a todos los miembros del grupo
    m_Metadata:
      m_Items: []
  - m_Id: 3486522174964507701
    m_Localized: "Gasta 15 de Dustium rojo\nManifiesta un Recuerdo aleatorio de calidad
      Com\xFAn a \xC9pica"
    m_Metadata:
      m_Items: []
  - m_Id: 7971315337770440506
    m_Localized: "Gasta 30 de Dustium rojo\nManifiesta un Recuerdo aleatorio de calidad
      Rara a \xDAnica"
    m_Metadata:
      m_Items: []
  - m_Id: 5870513392070568761
