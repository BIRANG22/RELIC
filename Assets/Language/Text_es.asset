    m_Metadata:
      m_Items: []
  - m_Id: 41385915724603466
    m_Localized: Gana defensa contra un objetivo debilitado.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915724603467
    m_Localized: "Cuando da\xF1as a un enemigo que ha sido debilitado, obtienes una
      armadura igual al valor."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915724603468
    m_Localized: "Otorga da\xF1o por envenenamiento a objetivos no envenenados."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915724603469
