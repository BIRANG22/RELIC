      m_Items: []
  - m_Id: 41385915728797796
    m_Localized: "Crear Telara\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797797
    m_Localized: "Crea una telara\xF1a en la posici\xF3n indicada."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797798
    m_Localized: "Telara\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797799
    m_Localized: "Duplica el coste de Man\xE1 necesario para moverse."
