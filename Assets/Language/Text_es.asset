  - m_Id: 41387432259100948
    m_Localized: Al comienzo de cada turno, para ti {E_Smite} {ValueRate1}
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100949
    m_Localized: Al comienzo de cada turno, para todos los aliados {E_Charge} {ValueRate1}
