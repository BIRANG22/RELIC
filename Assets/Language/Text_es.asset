      m_Items: []
  - m_Id: 41385915737186341
    m_Localized: "Poco com\xFAn"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186342
    m_Localized: "Trampa para osos port\xE1til"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186343
    m_Localized: "Crea un piso de espinas en la cuadr\xEDcula seleccionada. Moverse
      sobre el suelo de espinas sufre 3 da\xF1os, que duran hasta el final de la
      batalla."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186344
    m_Localized: "Poco com\xFAn"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186345
    m_Localized: "Mu\xF1eca Maldita"
    m_Metadata:
      m_Items: []
