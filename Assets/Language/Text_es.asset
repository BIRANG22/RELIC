      m_Items: []
  - m_Id: 41387432259100950
    m_Localized: Al comienzo de cada turno, para todos los enemigos {E_Poison} {ValueRate1}
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100951
    m_Localized: Al comienzo de cada turno, para todos los aliados {E_Armor} {ValueRate1}
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100952
    m_Localized: Al comienzo de cada turno, para ti {E_Boost} {ValueRate1}
