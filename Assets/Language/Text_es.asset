    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992018
    m_Localized: Alas de la Vanguardia
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992019
    m_Localized: "Reduce en {ValueRate1} el coste de Man\xE1 del primer Recuerdo
