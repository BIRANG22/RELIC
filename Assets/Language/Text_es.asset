    m_Localized: "Inmune a da\xF1os por colisi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797697
    m_Localized: "No sufre da\xF1os por colisiones."
    m_Metadata:
      m_Items: []
