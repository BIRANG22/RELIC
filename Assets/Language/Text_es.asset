      m_Items: []
  - m_Id: 41385915728797877
    m_Localized: "Pieza de \xC9ter"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797878
    m_Localized: "Aumenta el man\xE1 m\xE1ximo en {ValueRate1}."
