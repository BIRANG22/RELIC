    m_Metadata:
      m_Items: []
  - m_Id: 1847506937413929984
    m_Localized: "Tira 6 o m\xE1s\n\xC9xito: obt\xE9n un Artefacto aleatorio de calidad
      Com\xFAn a Rara\nFallo: termina el evento"
    m_Metadata:
      m_Items: []
  - m_Id: 3745294383723786182
    m_Localized: "Tira 8 o m\xE1s\n\xC9xito: obt\xE9n un Artefacto aleatorio de calidad
      Rara a \xC9pica\nFallo: termina el evento"
    m_Metadata:
      m_Items: []
  - m_Id: 2376006004967798544
    m_Localized: "Tira 10 o m\xE1s\n\xC9xito: obt\xE9n un Artefacto aleatorio de
      calidad \xC9pica a \xDAnica\nFallo: termina el evento"
    m_Metadata:
      m_Items: []
  - m_Id: 2931162308643722859
    m_Localized: "Tira 6 o m\xE1s\n\xC9xito: obt\xE9n 30 de Dustium rojo\nFallo:
      pierde 5 PV"
    m_Metadata:
      m_Items: []
  - m_Id: 7621201596966329862
    m_Localized: Finalizar el evento
    m_Metadata:
      m_Items: []
  - m_Id: 1189355817020927489
    m_Localized: "Tira 10 o m\xE1s\n\xC9xito: obt\xE9n 50 de Dustium rojo\nFallo:
      pierde 5 PV"
    m_Metadata:
      m_Items: []
  - m_Id: 1526258976528201190
