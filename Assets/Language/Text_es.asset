    m_Localized: "Sin da\xF1o Golpea el pr\xF3ximo turno"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797705
    m_Localized: "Si no has recibido da\xF1o durante el turno anterior, obtienes
      un golpe igual al valor al inicio del turno."
