    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100945
    m_Localized: Al comienzo de cada turno, para ti {E_Armor} {ValueRate1}
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100946
    m_Localized: Al comienzo de cada turno, para ti {E_Lifesteal} {ValueRate1}
