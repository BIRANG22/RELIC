  - m_Id: 9164888147097975814
    m_Localized: Rastro
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975815
    m_Localized: "Al desplazarse, deja baba en su posici\xF3n anterior."
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975816
    m_Localized: Movilidad
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975817
    m_Localized: Permite reservar hasta dos movimientos por turno.
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975818
    m_Localized: Contraataque
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975819
    m_Localized: "Contraataca con Golpe descendente cada vez que recibe da\xF1o de
      un ataque directo."
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975820
    m_Localized: "Fijaci\xF3n del objetivo"
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975821
    m_Localized: "Reserva un Tiro parab\xF3lico si no hay personajes en la misma
      l\xEDnea."
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975822
    m_Localized: Fortaleza
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975823
    m_Localized: Obtiene 10 de Armadura al comienzo del turno.
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975824
    m_Localized: Emboscada
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975825
    m_Localized: "Inflige un 30% m\xE1s de da\xF1o al atacar por la espalda."
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975826
    m_Localized: Nigromancia
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975827
    m_Localized: "Resucita a un mutante reducido a restos con un 30% de sus PV m\xE1ximos."
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975828
    m_Localized: "Creaci\xF3n de telara\xF1as"
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975829
    m_Localized: "Crea una telara\xF1a al comienzo del turno."
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975830
    m_Localized: Enredo
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975831
    m_Localized: "Al comienzo del turno, bloquea con una telara\xF1a una ranura aleatoria
      de la l\xEDnea temporal."
    m_Metadata:
      m_Items: []
