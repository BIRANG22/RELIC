    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797754
    m_Localized: Descuento en precio de tienda
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797755
    m_Localized: Reduce el precio de venta de la tienda en un porcentaje.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797756
    m_Localized: Moneda de recompensa de batalla aumentada
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797757
    m_Localized: Aumenta la cantidad de bienes de recompensa de batalla adquiridos
      por porcentaje.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797758
    m_Localized: "Recuperaci\xF3n despu\xE9s de la batalla"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915728797759
