      m_Items: []
  - m_Id: 41385915732992066
    m_Localized: "Talism\xE1n del profeta"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992067
    m_Localized: Al comienzo del turno 1, aplica {ValueRate1} de Vulnerabilidad y
