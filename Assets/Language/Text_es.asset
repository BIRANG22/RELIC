  m_TableData:
  - m_Id: 41387432259100673
    m_Localized: "Atr\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100674
    m_Localized: Confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100680
    m_Localized: Ajustes
