    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631945
    m_Localized: "Blessing \xB7 Boost"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631946
    m_Localized: Gain {ValueRate1} Boost at the start of battle.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631947
    m_Localized: "Blessing \xB7 Abundance"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631948
    m_Localized: Gain {ValueRate1}% more currency from battle rewards.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631949
