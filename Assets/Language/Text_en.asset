  - m_Id: 41385915657494528
    m_Localized: Hilt
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466048
    m_Localized: "\u201CYou say it\u2019s full of strong guys? Then I have to go.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466049
    m_Localized: Kaya
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466050
    m_Localized: "\u201CIf it\u2019s a mission, complete it. That\u2019s all.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466051
    m_Localized: Hayes
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466052
    m_Localized: "\u201CDo I really have to go?\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466053
    m_Localized: Ines
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466054
    m_Localized: "\u201CDon\u2019t worry. I\u2019ll make sure everyone returns safely.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466055
    m_Localized: Raina
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466056
    m_Localized: "\u201CI\u2019m just going because I want to go.\u201D"
    m_Metadata:
      m_Items: []
