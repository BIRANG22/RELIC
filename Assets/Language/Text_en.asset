  - m_Id: 41385915657494528
    m_Localized: Hilt
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466048
    m_Localized: "\u201CYou said the place is crawling with tough enemies? Then I\u2019m
      definitely going!\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466049
    m_Localized: Kaya
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466050
    m_Localized: "\u201CIf it\u2019s my mission, I\u2019ll see it through. Nothing
      more.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466051
    m_Localized: Hayes
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466052
    m_Localized: "\u201CDo I really have to go?\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466053
    m_Localized: Ines
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466054
    m_Localized: "\u201CDon\u2019t worry. I\u2019ll make sure we all make it back
      safely.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466056
    m_Localized: "\u201CI\u2019m going because I want to. That\u2019s all.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466057
    m_Localized: Murk
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466060
    m_Localized: Blob
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466063
    m_Localized: Lancer
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466066
    m_Localized: Blight
    m_Metadata:
