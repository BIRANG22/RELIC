    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631994
    m_Localized: Act before Mutants. Lose 1 stack at the end of the turn.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631995
    m_Localized: Smite
    m_Metadata:
      m_Items: []
