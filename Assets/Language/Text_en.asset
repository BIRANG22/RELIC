    m_Localized: Shadow Merchant
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510767
    m_Localized: "\u201CI never thought I would meet a customer in a place like this.
      I happen to have some nice items. Would you like to take a look?\u201D"
