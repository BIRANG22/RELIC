    m_Localized: Nocturne
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466085
    m_Localized: Teleport to the rear of the character\n.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466086
    m_Localized: Possesses surprise attack and deals strong damage when inflicting
      damage to the rear.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466087
    m_Localized: Mon_11
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466088
    m_Localized: 0
