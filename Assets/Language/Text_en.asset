    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631972
    m_Localized: "Ignore Armor and deal damage directly to the target\u2019s HP."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631973
    m_Localized: Knockback
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631974
    m_Localized: Push the target away from the caster.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631975
