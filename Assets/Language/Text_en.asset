    m_Localized: Gain {ValueRate1} Swiftness at the start of battle.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631943
    m_Localized: "Blessing \xB7 Smite"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631944
