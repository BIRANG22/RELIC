      m_Items: []
  - m_Id: 41385915678466048
    m_Localized: "\u201CThey say it's crawling with powerful enemies? Then I have
      to go!\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466049
    m_Localized: Kaya
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466050
    m_Localized: "\u201CIf it's my mission, I'll complete it. That's all.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466051
    m_Localized: Hayes
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466052
    m_Localized: "\u201CDo we really have to go\u2026? I'm scared, but I'll try.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466053
    m_Localized: Ines
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466054
    m_Localized: "\u201CDon't worry. I'll protect everyone.\u201D"
    m_Metadata:
      m_Items: []
