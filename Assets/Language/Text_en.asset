    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631969
    m_Localized: Damage
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631970
    m_Localized: Deal damage to the target. Armor is reduced before HP.
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631971
