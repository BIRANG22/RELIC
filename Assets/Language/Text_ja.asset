  - m_Id: 41385915691048991
    m_Localized: "\u30C9\u30E9\u30B4\u30F3\u30B9\u30B1\u30FC\u30EB\u30FB\u30D5\u30A9\u30FC\u30AF"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048992
    m_Localized: "\u30BF\u30FC\u30F3 1 \u306E\u958B\u59CB\u6642\u306B\u3001{ValueRate1}
      Ward \u3092\u7372\u5F97\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048993
    m_Localized: "\u30C9\u30E9\u30B4\u30F3\u30B9\u30B1\u30FC\u30EB\u30FB\u30D5\u30E5\u30FC\u30EA\u30FC"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048994
    m_Localized: "\u56DE\u5FA9\u6642\u3001\u904E\u5270\u306A\u56DE\u5FA9\u91CF\u306B\u7B49\u3057\u3044\u30A2\u30FC\u30DE\u30FC\u3092\u7372\u5F97\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048995
    m_Localized: "\u30C9\u30E9\u30B4\u30F3\u30B9\u30B1\u30FC\u30EB\u30FB\u30AC\u30FC\u30C7\u30A3\u30A2\u30F3"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048996
    m_Localized: "\u30BF\u30FC\u30F3\u958B\u59CB\u6642\u306B\u3001\u5C11\u306A\u304F\u3068\u3082
      {ValueRate1} \u30A2\u30FC\u30DE\u30FC\u3092\u6301\u3063\u3066\u3044\u308B\u5834\u5408\u3001\u30B9\u30DE\u30A4\u30C8\u3092
      1 \u7372\u5F97\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048997
    m_Localized: "\u30C9\u30E9\u30B4\u30F3\u30B9\u30B1\u30FC\u30EB\u30FB\u30AF\u30A8\u30A4\u30AF"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048998
    m_Localized: "\u5404\u30BF\u30FC\u30F3\u306E\u958B\u59CB\u6642\u306B HP \u304C
      3 \u6E1B\u5C11\u3057\u3001{ValueRate1} \u30D6\u30FC\u30B9\u30C8\u3092\u7372\u5F97\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048999
    m_Localized: "\u30C9\u30E9\u30B4\u30F3\u30B9\u30B1\u30FC\u30EB\u30FB\u30AA\u30F3\u30B9\u30ED\u30FC\u30C8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691049000
    m_Localized: "HP 50% \u4EE5\u4E0B\u306E\u5834\u5408\u3001\u4E0E\u3048\u308B\u30C0\u30E1\u30FC\u30B8\u304C
      {ValueRate1}% \u5897\u52A0\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691049001
    m_Localized: "\u30BD\u30FC\u30C9\u30CF\u30FC\u30C8\u30FB\u30AD\u30FC\u30A8\u30C3\u30B8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631872
    m_Localized: "\u6226\u95D8\u30AD\u30E5\u30FC\u306B\u3042\u308B\u30E1\u30E2\u30EA\u306E\u6700\u521D\u306E\u653B\u6483\u306F\u3001{ValueRate1}
