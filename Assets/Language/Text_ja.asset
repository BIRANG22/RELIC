    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986885
    m_Localized: "\u30BF\u30FC\u30F3\u958B\u59CB\u6642\u306B\u30AB\u30EB\u30DE\u304C\u6700\u5927\u306E\u5834\u5408\u3001HP\u304C\u6700\u5927HP\u3088\u308A\u4F4E\u3044\u5473\u65B9\u306EHP\u30921\u56DE\u5FA9\u3059\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986888
    m_Localized: "\u6210\u529F\u78BA\u738730%\n\u6210\u529F\uFF1A\u9078\u629E\u3057\u305F\u30E1\u30E2\u30EA\u30FC1\u500B\u3092\u899A\u9192\u3055\u305B\u308B\n\u5931\u6557:
      \u9078\u629E\u3057\u305F\u30E1\u30E2\u30EA\u3092\u7834\u58CA\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986895
    m_Localized: "\u53E4\u3044\u7BB1\u3084\u6B63\u4F53\u4E0D\u660E\u306E\u796D\u5177\u304C\u8EE2\u304C\u3063\u3066\u3044\u307E\u3059\u3002\u4ECA\u3082\u306F\u3063\u304D\u308A\u3068\u610F\u8B58\u306E\u75D5\u8DE1\u304C\u6B8B\u3063\u3066\u3044\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986896
    m_Localized: "\u30B5\u30A4\u30B3\u30ED\u306E\u6C7A\u5B9A\n\u5024\u304C\u9AD8\u3044\u307B\u3069\u6700\u5927HP\u304C\u5897\u52A0\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986897
    m_Localized: "\u6210\u529F\u306E\u78BA\u7387\u306F 90%\n\u6210\u529F\uFF1A\u9078\u629E\u3057\u305F\u30E1\u30E2\u30EA\u30FC1\u500B\u3092\u899A\u9192\u3055\u305B\u308B\n\u5931\u6557:
      \u9078\u629E\u3057\u305F\u30E1\u30E2\u30EA\u3092\u7834\u58CA\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986906
    m_Localized: "\u5BFE\u8C61\u306B\u5F37\u529B\u306A\u65AC\u6483\u3092\u4E0E\u3048\u308B\n7
      \u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u30011 \u30B9\u30DA\u30FC\u30B9\u5F8C\u9000\u3055\u305B\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986914
    m_Localized: "1. 5 \u3064\u306E\u30B9\u30ED\u30C3\u30C8\u304B\u3089 1 \u3064\u3092\u9078\u629E\u3057\u307E\u3059\u3002\n2.
      \u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u307E\u305F\u306F HUD \u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u3001\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306E\u30B9\u30AD\u30EB\u30EA\u30B9\u30C8\u3092\u958B\u304D\u307E\u3059\u3002\n3.
      \u79FB\u52D5\u30B9\u30AD\u30EB\u3092\u9078\u629E\u3057\u305F\u5F8C\u3001\u3055\u3089\u306B\u79FB\u52D5\u5148\u306E\u30B0\u30EA\u30C3\u30C9\u3092\u9078\u629E\u3057\u307E\u3059\u3002\n4.
      \u653B\u6483\u30B9\u30AD\u30EB\u3068\u30D0\u30D5\u30B9\u30AD\u30EB\u306F\u9032\u884C\u65B9\u5411\u306B\u81EA\u52D5\u7684\u306B\u767B\u9332\u3055\u308C\u307E\u3059\u3002\n3.
      \u30EA\u30BD\u30FC\u30B9\u3092\u4F7F\u7528\u3057\u3066\u30B9\u30AD\u30EB\u3092\u767B\u9332\u3057\u3001\u30BF\u30FC\u30F3\u3092\u7D42\u4E86\u3057\u307E\u3059\u3002\n\n\n-
      \u30BF\u30A4\u30E0\u30E9\u30A4\u30F3\u4E0A\u306B\u30DE\u30A6\u30B9\u3092\u7F6E\u304F\u3068\u3001\u30A2\u30AF\u30B7\u30E7\u30F3\u306E\u76EE\u6A19\u3068\u9032\u6357\u72B6\u6CC1\u306E\u60C5\u5831\u304C\u8868\u793A\u3055\u308C\u307E\u3059\u3002\n\u30FB\u30BF\u30A4\u30E0\u30E9\u30A4\u30F3\u4E0A\u3067\u767B\u9332\u6E08\u307F\u306E\u30B9\u30AD\u30EB\u3092\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u3068\u767B\u9332\u3092\u89E3\u9664\u3067\u304D\u307E\u3059\u3002\n-
