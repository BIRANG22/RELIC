      m_Items: []
  - m_Id: 41385915703631875
    m_Localized: "\u30BD\u30FC\u30C9\u30CF\u30FC\u30C8\u30FB\u30D5\u30EB\u30FC\u30EA\u30FC"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631876
    m_Localized: "\u5C11\u306A\u304F\u3068\u3082 {CountRate1} \u30D2\u30C3\u30C8\u306E\u601D\u3044\u51FA\u306F\u3001{ValueRate1}
