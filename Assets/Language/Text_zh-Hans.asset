  - m_Id: 41385915691048991
    m_Localized: "\u9F99\u9CDE\xB7\u6297\u4E89"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048992
    m_Localized: "\u7B2C 1 \u56DE\u5408\u5F00\u59CB\u65F6\uFF0C\u83B7\u5F97 {ValueRate1}
      \u5C42\u5C4F\u969C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048993
    m_Localized: "\u9F99\u9CDE\xB7\u6FC0\u6602"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048994
    m_Localized: "\u751F\u547D\u503C\u6EA2\u51FA\u6CBB\u7597\u65F6\uFF0C\u83B7\u5F97\u7B49\u540C\u4E8E\u6EA2\u51FA\u6CBB\u7597\u91CF\u7684\u62A4\u7532\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048995
    m_Localized: "\u9F99\u9CDE\xB7\u5B88\u62A4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048996
    m_Localized: "\u56DE\u5408\u5F00\u59CB\u65F6\uFF0C\u82E5\u62A4\u7532\u4E0D\u4F4E\u4E8E
      {ValueRate1}\uFF0C\u83B7\u5F97 1 \u5C42\u91CD\u51FB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048997
    m_Localized: "\u9F99\u9CDE\xB7\u9707\u8361"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048998
    m_Localized: "\u6BCF\u56DE\u5408\u5F00\u59CB\u65F6\u5931\u53BB 3 \u70B9\u751F\u547D\u503C\uFF0C\u5E76\u83B7\u5F97
      {ValueRate1} \u5C42\u589E\u5E45\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048999
    m_Localized: "\u9F99\u9CDE\xB7\u731B\u51FB"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691049000
    m_Localized: "\u5F53\u524D\u751F\u547D\u503C\u4E0D\u9AD8\u4E8E 50% \u65F6\uFF0C\u9020\u6210\u7684\u4F24\u5BB3\u63D0\u9AD8
      {ValueRate1}%\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691049001
    m_Localized: "\u5251\u5FC3\xB7\u950B\u8292"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631872
    m_Localized: "\u6BCF\u573A\u6218\u6597\u4E2D\u9996\u6B21\u767B\u8BB0\u7684\u653B\u51FB\u8BB0\u5FC6\u989D\u5916\u653B\u51FB
      {ValueRate1} \u6B21\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631873
    m_Localized: "\u5251\u5FC3\xB7\u5DC5\u5CF0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631874
    m_Localized: "\u6700\u540E\u4E00\u6B21\u653B\u51FB\u540E\uFF0C\u6839\u636E\u8FDE\u7EED\u767B\u8BB0\u7684\u653B\u51FB\u6570\u91CF\u9020\u6210\u7A7F\u900F\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631875
    m_Localized: "\u5251\u5FC3\xB7\u6D41\u5203"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631876
    m_Localized: "\u653B\u51FB\u6B21\u6570\u8FBE\u5230 {CountRate1} \u6B21\u4EE5\u4E0A\u7684\u8BB0\u5FC6\uFF0C\u9020\u6210\u7684\u4F24\u5BB3\u589E\u52A0
      {ValueRate1}\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631877
    m_Localized: "\u5251\u5FC3\xB7\u4E00\u95EA"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631878
    m_Localized: "\u9020\u6210\u7A7F\u900F\u4F24\u5BB3\u65F6\uFF0C\u5BF9\u76EE\u6807\u65BD\u52A0
