      m_Items: []
  - m_Id: 21894353345060870
    m_Localized: "\uC790\uC2E0\uC774 \uACF5\uACA9\uD560 \uB54C \uCDE8\uC57D\uC758
      \uD53C\uD574 \uC99D\uAC00\uC728\uC774 {ValueRate1}%\uB85C \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21894353345060871
    m_Localized: "\uCE74\uB974\uB9C8\uAC00 \uCD5C\uB300\uCE58\uC5D0 \uB3C4\uB2EC\uD558\uBA74
      \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uCDE8\uC57D\uC744 \uC218\uCE58 \uBD80\uC5EC\uD55C\uB2E4."
