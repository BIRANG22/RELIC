    m_Metadata:
      m_Items: []
  - m_Id: 21894353345060867
    m_Localized: "\uC0DD\uBA85\uB825 75% \uC774\uC0C1\uC5D0\uC11C \uD68C\uBCF5 \uC2DC
      \uAC00\uC7A5 \uBA3C\uC800 \uBD80\uC5EC\uB41C \uB514\uBC84\uD504 \uC218\uCE58\uAC00
