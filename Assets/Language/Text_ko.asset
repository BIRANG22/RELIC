    m_Localized: "\uCE74\uB974\uB9C8\uB97C \uC0AC\uC6A9\uD558\uB294 \uAE30\uC5B5\uC758
      \uD69F\uC218\uAC00 {ValueRate1}\uD68C \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992177
    m_Localized: "\uBD80\uC2EF\uB3CC"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992178
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uB9C8\uB098\uAC00 0\uC774\uB77C\uBA74
      \uB9C8\uB098\uB97C {ValueRate1} \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992180
    m_Localized: "\uBD88\uBC1C\uD0C4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992181
    m_Localized: "\uACF5\uACA9\uC774 \uC801\uC911\uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74
      \uB9C8\uB098\uB97C {ValueRate1} \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992183
    m_Localized: "\uCC98\uD615\uC778\uC758 \uC548\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992184
    m_Localized: "\uC0DD\uBA85\uB825\uC774 \uCD5C\uB300\uC778 \uC801\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC8FC\uBA74, \uD53C\uD574\uB7C9\uC774 {ValueRate1}\uBC30\uB85C
      \uC801\uC6A9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915732992186
    m_Localized: "\uBE14\uB7ED\uC9D1"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186304
    m_Localized: "\uD734\uC2DD\uC73C\uB85C \uD68C\uBCF5\uD558\uB294 \uC0DD\uBA85\uB825\uC774
      {ValueRate1}% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186306
    m_Localized: "\uC0C1\uC778\uC758 \uAE08\uC778\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186307
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C \uD310\uB9E4\uD558\uB294 \uBAA8\uB4E0
      \uBB3C\uD488\uC758 \uAC00\uACA9\uC774 {ValueRate1}% \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186309
    m_Localized: "\uAD6C\uC2AC \uC8FC\uBA38\uB2C8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186310
    m_Localized: "\uC804\uD22C \uBCF4\uC0C1\uC73C\uB85C \uD68D\uB4DD\uD558\uB294
      \uC7AC\uD654\uC758 \uC591\uC774 {ValueRate1}% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186312
    m_Localized: "\uBD95\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186313
    m_Localized: "\uC804\uD22C \uC885\uB8CC \uD6C4 \uC0DD\uBA85\uB825\uC744 {ValueRate1}
      \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186360
    m_Localized: "\uB048\uC801\uD55C \uC824"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186362
    m_Localized: "\uBA38\uD06C\uC758 \uBAB8\uC744 \uC774\uB8E8\uB358 \uC810\uC131\uC774
      \uAC15\uD55C \uC824. \uCE68\uC2DD\uB41C \uC870\uC9C1\uC758 \uD754\uC801\uC774
      \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186363
    m_Localized: "\uB9D0\uB791\uD55C \uC810\uC561"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186365
    m_Localized: "\uBE14\uB86D\uC5D0\uAC8C\uC11C \uCC44\uCDE8\uD55C \uBD80\uB4DC\uB7EC\uC6B4
      \uC810\uC561. \uD615\uD0DC\uAC00 \uC27D\uAC8C \uBCC0\uD558\uBA74\uC11C\uB3C4
      \uB048\uC801\uD55C \uC131\uC9C8\uC744 \uC720\uC9C0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186366
    m_Localized: "\uD0C0\uC624\uB974\uB294 \uCF54\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186368
    m_Localized: "\uB79C\uC11C\uC758 \uB0B4\uBD80\uC5D0\uC11C \uAEBC\uB0B8 \uB728\uAC70\uC6B4
      \uCF54\uC5B4. \uAEBC\uC9C4 \uB4A4\uC5D0\uB3C4 \uBBF8\uC57D\uD55C \uC5F4\uAE30\uC640
      \uC5D0\uB108\uC9C0\uAC00 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186369
    m_Localized: "\uC624\uC5FC\uB41C \uCF54\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186371
    m_Localized: "\uBE14\uB77C\uC774\uD2B8\uC5D0\uAC8C\uC11C \uC5BB\uC740 \uD0C1\uD558\uAC8C
      \uBCC0\uC0C9\uB41C \uCF54\uC5B4. \uC8FC\uBCC0\uC758 \uBB3C\uC9C8\uC744 \uCC9C\uCC9C\uD788
      \uCE68\uC2DD\uC2DC\uD0A4\uB294 \uAE30\uC6B4\uC774 \uAC10\uB3C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186372
    m_Localized: "\uB2E8\uB2E8\uD55C \uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186374
    m_Localized: "\uBCA0\uC2A4\uD30C\uC758 \uBAB8\uC5D0\uC11C \uB5A8\uC5B4\uC838
      \uB098\uC628 \uB2E8\uB2E8\uD55C \uCE68. \uB0A0\uCE74\uB85C\uC6B4 \uB05D\uBD80\uBD84\uC5D0
      \uBCC0\uC774\uB41C \uB3C5\uC131 \uC131\uBD84\uC774 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186375
    m_Localized: "\uAC70\uBBF8 \uB2E4\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186377
    m_Localized: "\uC2E0\uB354\uC5D0\uAC8C\uC11C \uC798\uB77C\uB0B8 \uB2E8\uB2E8\uD55C
      \uB2E4\uB9AC. \uC678\uD53C\uB294 \uAC00\uBCCD\uC9C0\uB9CC \uCDA9\uACA9\uC5D0
      \uC27D\uAC8C \uBD80\uC11C\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186378
    m_Localized: "\uBD80\uB7EC\uC9C4 \uB3C4\uB07C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186380
    m_Localized: "\uB4DC\uB77C\uC6B0\uADF8\uAC00 \uC0AC\uC6A9\uD558\uB358 \uB3C4\uB07C.
      \uC624\uB798\uB41C \uAE08\uC18D \uD45C\uBA74\uC5D0 \uCE68\uC2DD\uACFC \uBD80\uD328\uC758
      \uD754\uC801\uC774 \uACB9\uACB9\uC774 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186381
    m_Localized: "\uB179\uC2A8 \uD654\uC0B4\uCD09"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186383
    m_Localized: "\uBC14\uB85C\uC6B0\uAC00 \uC0AC\uC6A9\uD558\uB358 \uD654\uC0B4\uC758
      \uCD09. \uB179\uC774 \uC2EC\uD558\uAC8C \uC2AC\uC5C8\uC9C0\uB9CC \uB05D\uBD80\uBD84\uC5D0\uB294
      \uBCC0\uC774\uCCB4 \uD2B9\uC720\uC758 \uAE30\uC6B4\uC774 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186384
    m_Localized: "\uBC29\uD328 \uC870\uAC01"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186386
    m_Localized: "\uB8E8\uD06C\uC758 \uBC29\uD328\uC5D0\uC11C \uB5A8\uC5B4\uC838
      \uB098\uC628 \uD30C\uD3B8. \uC791\uC740 \uC870\uAC01\uC784\uC5D0\uB3C4 \uC0C1\uB2F9\uD55C
      \uCDA9\uACA9\uC744 \uACAC\uB51C \uB9CC\uD07C \uB2E8\uB2E8\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186387
    m_Localized: "\uADF8\uB9BC\uC790 \uAC11\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186389
    m_Localized: "\uB179\uD134\uC758 \uAC11\uC8FC\uC5D0\uC11C \uB5A8\uC5B4\uC838
      \uB098\uC628 \uAC80\uC740 \uC870\uAC01. \uBE5B\uC744 \uBC1B\uC73C\uBA74 \uD45C\uBA74\uC758
      \uADF8\uB9BC\uC790\uAC00 \uBBF8\uC138\uD558\uAC8C \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186390
    m_Localized: "\uD63C\uB839\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186392
    m_Localized: "\uBAA8\uB974\uD2B8\uC758 \uC0AC\uB839\uC220\uACFC \uC5F0\uAD00\uB41C
      \uD798\uC774 \uC751\uCD95\uB41C \uACB0\uC815. \uAC00\uAE4C\uC774 \uB450\uBA74
      \uD76C\uBBF8\uD55C \uC6B8\uB9BC\uC774 \uB290\uAEF4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186393
    m_Localized: "\uBD80\uC11C\uC9C4 \uC655\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380608
    m_Localized: "\uC544\uB77C\uBCA8\uB77C\uAC00 \uC9C0\uB2C8\uACE0 \uC788\uB358
      \uC655\uAD00\uC758 \uD30C\uD3B8. \uAC15\uD55C \uCE68\uC2DD\uC758 \uD754\uC801\uC744
      \uD488\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380634
    m_Localized: "\uD68D\uB4DD\uD55C \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380635
    m_Localized: "\uD68D\uB4DD \uAC00\uB2A5\uD55C \uAE30\uC5B5\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380637
    m_Localized: "\uB178\uB4DC \uC815\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380638
    m_Localized: "\uB178\uB4DC\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB824 \uC815\uBCF4\uB97C
      \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380639
    m_Localized: "\uC0C8\uB85C\uC6B4 \uD0D0\uC0AC\uB97C \uC2DC\uC791\uD558\uB294
      \uCD9C\uBC1C\uC810\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380640
    m_Localized: "\uC0C1\uCC98\uB97C \uD68C\uBCF5\uD558\uACE0 \uC804\uC5F4\uC744
      \uAC00\uB2E4\uB4EC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380641
    m_Localized: "\uC608\uCE21\uD560 \uC218 \uC5C6\uB294 \uC0AC\uAC74\uACFC \uB9C8\uC8FC\uCE69\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380642
    m_Localized: "\uC801\uC744 \uBB3C\uB9AC\uCE58\uACE0 \uC55E\uC73C\uB85C \uB098\uC544\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380643
    m_Localized: "\uAC15\uB825\uD55C \uC801\uC744 \uB118\uC5B4 \uAC12\uC9C4 \uBCF4\uC0C1\uC744
      \uB178\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380644
    m_Localized: "\uD0D0\uC0AC\uC758 \uB05D\uC744 \uC9C0\uD0A4\uB294 \uC6B0\uB450\uBA38\uB9AC\uC640
      \uACB0\uC804\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380657
    m_Localized: "\uC18C\uBAA8 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380658
    m_Localized: "\uC0DD\uBA85\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380660
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380661
    m_Localized: "\uD53C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380662
    m_Localized: "\uC790\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380663
    m_Localized: "\uD6A8\uACFC \uC124\uBA85\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380664
    m_Localized: "\uBD84\uB178"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380665
    m_Localized: "\uAE30\uC138"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380666
    m_Localized: "\uC5D0\uD14C\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380667
    m_Localized: "\uC2E0\uC559"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380668
    m_Localized: "\uD608\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380669
    m_Localized: "\uACE0\uC720\uC790\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380682
    m_Localized: "\uC774\uB3D9 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380690
    m_Localized: "\uBA40\uD2F0 \uBC30\uD2C0\uC5D0\uC11C\uB294 \uD638\uC2A4\uD2B8\uB9CC
      \uAC00\uBC29\uC744 \uBCC0\uACBD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380691
    m_Localized: "\uBC84\uB9B4 \uACE0\uC720 \uC544\uC774\uD15C\uC744 \uBA3C\uC800
      \uC120\uD0DD\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380692
    m_Localized: "\uC120\uD0DD\uD55C \uACE0\uC720 \uC544\uC774\uD15C\uC744 \uCC3E\uC744
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380693
    m_Localized: "\uC774 \uC2AC\uB86F\uC5D0\uB294 \uC2A4\uD0AC\uC744 \uB4F1\uB85D\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380694
    m_Localized: "\uC2A4\uD0AC\uC744 \uB4F1\uB85D\uD560 \uC218 \uC788\uB294 \uC2AC\uB86F\uC740
      {0}\uAC1C\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380695
    m_Localized: "\uC608\uC57D\uD560 \uC2A4\uD0AC \uC815\uBCF4\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380696
    m_Localized: "\uC120\uD0DD\uD55C \uCE90\uB9AD\uD130\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380698
    m_Localized: "\uD604\uC7AC \uC0C1\uD0DC\uC5D0\uC11C\uB294 \uC608\uC57D\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380699
    m_Localized: "\uC0DD\uBA85\uB825\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380700
    m_Localized: "\uB9C8\uB098\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380701
    m_Localized: "{0} \uB354\uC2A4\uD2F0\uC6C0\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380702
    m_Localized: "{0}\uC73C\uB85C \uAC15\uD654\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380703
    m_Localized: "\uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uC758 \uCE90\uB9AD\uD130\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380704
    m_Localized: "\uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uAC00 \uC608\uC57D\uD55C
      \uC2AC\uB86F\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380705
    m_Localized: "\uB124\uD2B8\uC6CC\uD06C \uBA85\uB839 \uC804\uC1A1\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380707
    m_Localized: "\uD6A8\uACFC \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915741380708
    m_Localized: "\uBC30\uC591\uC870"
    m_Metadata:
