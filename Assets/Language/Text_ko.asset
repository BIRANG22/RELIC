    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826194
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uC218\uCE58\uAC00 1 \uAC10\uC18C\uD569\uB2C8\uB2E4.
      \uC218\uCE58\uAC00 0\uC774 \uB418\uBA74 \uC790\uD3ED\uC744 \uC2DC\uC804\uD558\uACE0
