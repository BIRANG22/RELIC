    m_Localized: B
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186383
    m_Localized: "\uC5B4\uB450\uC6B4 \uAE30\uC6B4\uC744 \uD488\uC740 \uACB0\uC815\uC774\uB2E4.
      \uD310\uB9E4 \uC2DC 25 \uB354\uC2A4\uD2F0\uC6C0\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186384
