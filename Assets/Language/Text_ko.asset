    m_Localized: "\uBA54\uB9C8\uB978 \uBCF4\uAE09"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093516
    m_Localized: "\uC0C1\uC810 \uAC00\uACA9\uC774 15% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093517
    m_Localized: "\uB4A4\uD2C0\uB9B0 \uC6B4\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093518
    m_Localized: "\uB09C\uC774\uB3C4 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093519
    m_Localized: "\uD734\uC2DD\uBC29 \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093520
    m_Localized: "\uBCF4\uC2A4\uBC29 \uC785\uC7A5 \uC804\uC5D0 \uBC30\uCE58\uB418\uB294
      \uD734\uC2DD\uBC29\uC744 \uC81C\uAC70\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093521
    m_Localized: "\uC2DC\uC57C \uC81C\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093522
    m_Localized: "\uC9C0\uB3C4\uC5D0\uC11C \uB2E4\uC74C \uBC29\uC758 \uC885\uB958\uB97C
      \uD655\uC778\uD560 \uC218 \uC5C6\uAC8C \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093523
    m_Localized: "\uAC15\uC778\uD55C \uBCC0\uC774\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093524
    m_Localized: "\uBCC0\uC774\uCCB4\uC758 \uCD5C\uB300 \uC0DD\uBA85\uB825\uC774
      20% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093525
    m_Localized: "\uD749\uD3EC\uD55C \uBCC0\uC774\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093526
    m_Localized: "\uBCC0\uC774\uCCB4\uAC00 \uC8FC\uB294 \uD53C\uD574\uAC00 50% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093527
    m_Localized: "\uC1E0\uC57D\uD55C \uC721\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093528
    m_Localized: "\uBAA8\uB4E0 \uCE90\uB9AD\uD130\uC758 \uCD5C\uB300 \uC0DD\uBA85\uB825\uC774
      10% \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093529
    m_Localized: "\uBD88\uAE38\uD55C \uC9D5\uD6C4"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093530
    m_Localized: "\uB09C\uC774\uB3C4 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093531
    m_Localized: "\uBA54\uB9C8\uB978 \uBCF4\uAE09"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093532
    m_Localized: "\uC0C1\uC810 \uAC00\uACA9\uC774 30% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093533
    m_Localized: "\uB4A4\uD2C0\uB9B0 \uC6B4\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093534
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 \uB09C\uC774\uB3C4\uAC00 1 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093535
    m_Localized: "\uB808\uC5B4\uB3C4 \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093536
    m_Localized: "\uB192\uC740 \uB808\uC5B4\uB3C4\uC758 \uB4F1\uC7A5 \uD655\uB960\uC744
      \uAC10\uC18C\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093537
    m_Localized: "\uC5F0\uC131\uC81C \uC81C\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093538
    m_Localized: "\uC5F0\uC131\uC81C\uB97C \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093539
    m_Localized: "\uAC15\uC778\uD55C \uBCC0\uC774\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093540
    m_Localized: "\uBCC0\uC774\uCCB4\uC758 \uCD5C\uB300 \uC0DD\uBA85\uB825\uC774
      30% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093541
    m_Localized: "\uD749\uD3EC\uD55C \uBCC0\uC774\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093542
    m_Localized: "\uB09C\uC774\uB3C4 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093543
    m_Localized: "\uC1E0\uC57D\uD55C \uC721\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093544
    m_Localized: "\uBAA8\uB4E0 \uCE90\uB9AD\uD130\uC758 \uCD5C\uB300 \uC0DD\uBA85\uB825\uC774
      20% \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093545
    m_Localized: "\uBD88\uAE38\uD55C \uC9D5\uD6C4"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093546
    m_Localized: "3\uD134\uB9C8\uB2E4 \uD30C\uD2F0\uC5D0 \uBB34\uC791\uC704 \uB514\uBC84\uD504
      1\uAC1C\uB97C \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093547
    m_Localized: "\uBA54\uB9C8\uB978 \uBCF4\uAE09"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093548
    m_Localized: "\uB09C\uC774\uB3C4 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093549
    m_Localized: "\uB4A4\uD2C0\uB9B0 \uC6B4\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093550
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 \uB09C\uC774\uB3C4\uAC00 2 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093551
    m_Localized: "\uC720\uBB3C \uC2AC\uB86F \uC7A0\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093552
    m_Localized: "\uCE90\uB9AD\uD130\uC758 \uB9C8\uC9C0\uB9C9 \uC720\uBB3C \uC2AC\uB86F\uC744
      \uC7A0\uADFC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093553
    m_Localized: "\uBB34\uAC70\uC6B4 \uBC1C\uAC78\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974323093554
    m_Localized: "\uC774\uB3D9\uC5D0 \uD544\uC694\uD55C \uCD5C\uC885 \uB9C8\uB098
      \uC18C\uBAA8\uAC00 1 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665076396032
    m_Localized: "\u201C\uAC15\uD55C \uB188\uB4E4\uC774 \uB4DD\uC2E4\uAC70\uB9B0\uB2E4\uBA70?\n\uADF8\uB7FC
      \uB0B4\uAC00 \uAC00\uC57C\uC9C0.\u201D\n\n\uBCA8\uAC00\uB4DC \uC6A9\uBCD1\uB2E8\uC758
      \uC6A9\uBCD1.\n\uD638\uC804\uC801\uC774\uACE0 \uAC70\uCE68\uC5C6\uB294 \uC131\uACA9\uC73C\uB85C,
      \uC704\uD5D8\uD55C \uC804\uD22C\uC77C\uC218\uB85D \uC55E\uC7A5\uC11C\uBA70
      \uC774\uBC88 \uD0D0\uC0AC\uC5D0\uC11C\uB3C4 \uC790\uC2E0\uC758 \uAC15\uD568\uC744
      \uC99D\uBA85\uD558\uB824 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173248
    m_Localized: "\u201C\uC784\uBB34\uB77C\uBA74 \uC644\uC218\uD55C\uB2E4. \uADF8\uBFD0\uC774\uC57C.\u201D\n\n\uD558\uCFE0\uB80C
      \uAC00\uBB38\uC758 \uAC80\uC0AC.\n\uCE68\uCC29\uD558\uACE0 \uB0C9\uCCA0\uD558\uBA70
      \uC5B4\uB5A4 \uC0C1\uD669\uC5D0\uC11C\uB3C4 \uD750\uD2B8\uB7EC\uC9C0\uC9C0
      \uC54A\uB294\uB2E4. \uBBF8\uC9C0\uC758 \uC801\uB4E4\uACFC \uB9DE\uC11C\uBA70
      \uC790\uC2E0\uC758 \uAC80\uC220\uC744 \uB354\uC6B1 \uC644\uC131\uD574 \uB098\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173249
    m_Localized: "\u201C\uC815\uB9D0 \uC81C\uAC00 \uAC00\uC57C \uD558\uB294 \uAC74\uAC00\uC694?\u201D\n\n\uC544\uC2A4\uD154
      \uD559\uD68C\uC758 \uD559\uC790.\n\uAC81\uC774 \uB9CE\uACE0 \uC18C\uC2EC\uD558\uC9C0\uB9CC
      \uB9E1\uC740 \uC5F0\uAD6C\uC5D0\uC11C\uB294 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uB294\uB2E4.
      \uC18C\uD658\uC218 \uB2C8\uC544\uC640 \uD568\uAED8 \uD0D0\uC0AC\uC5D0 \uB098\uC11C\uBA70
      \uC790\uC2E0\uC758 \uB098\uC57D\uD568\uC744 \uADF9\uBCF5\uD558\uB824 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173250
    m_Localized: "\u201C\uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694.\n\uBAA8\uB450
      \uBB34\uC0AC\uD788 \uB3CC\uC544\uAC08 \uC218 \uC788\uB3C4\uB85D \uD560\uAC8C\uC694.\u201D\n\n\uC138\uB77C\uD53C\uC544
      \uAD50\uB2E8\uC758 \uC9D1\uD589\uC790.\n\uBC1D\uACE0 \uC0C1\uB0E5\uD55C \uC131\uACA9\uC73C\uB85C
      \uB3D9\uB8CC\uB4E4\uC744 \uC0B4\uB730\uD788 \uBCF4\uC0B4\uD540\uB2E4. \uD558\uC9C0\uB9CC
      \uADF8\uB4E4\uC744 \uC704\uD611\uD558\uB294 \uC874\uC7AC \uC55E\uC5D0\uC11C\uB294
      \uB9DD\uC124\uC784 \uC5C6\uC774 \uB0C9\uD639\uD55C \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173251
    m_Localized: "\u201C\uADF8\uB0E5 \uB0B4\uAC00 \uAC00\uACE0 \uC2F6\uC5B4\uC11C
      \uAC00\uB294 \uAC70\uC57C.\u201D\n\n\uC790\uC720\uB86D\uAC8C \uB5A0\uB3C4\uB294
      \uBC29\uB791\uC790.\n\uB9D0\uC218\uAC00 \uC801\uACE0 \uC790\uC720\uBD84\uBC29\uD558\uBA70
      \uD0C0\uC778\uC758 \uADDC\uCE59\uC5D0 \uC5BD\uB9E4\uC774\uC9C0 \uC54A\uB294\uB2E4.
      \uC790\uC2E0\uC758 \uAD00\uC2EC\uC774 \uD5A5\uD55C \uD0D0\uC0AC\uB300\uB97C
      \uB530\uB77C \uC2A4\uC2A4\uB85C \uC704\uD5D8 \uC18D\uC73C\uB85C \uBC1C\uC744
      \uB4E4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173252
    m_Localized: "\uB4DC\uB77C\uC6B0\uADF8"
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173253
    m_Localized: "\uBC14\uB85C\uC6B0"
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173254
    m_Localized: "\uB8E8\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173255
    m_Localized: "\uBAA8\uB974\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173256
    m_Localized: "\uCD5C\uB300   HP"
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173257
    m_Localized: "\uC0DD\uBA85\uB825 \uC790\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173258
    m_Localized: "\uAE30\uC5B5\uC0AC\uC6A9\uC5D0 \uD544\uC694\uD55C \uC790\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173259
    m_Localized: "\uBC29\uC5B4\uB3C4\uB97C \uBB34\uC2DC\uD558\uACE0 \uB300\uC0C1\uC758
      \uC0DD\uBA85\uB825\uC5D0 \uC9C1\uC811 \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173260
    m_Localized: "\uC0DD\uBA85\uB825\uC744 \uC218\uCE58\uB9CC\uD07C \uC989\uC2DC
      \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173261
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uB9C8\uB098\uB97C \uC218\uCE58\uB9CC\uD07C
      \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173262
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uCE74\uB974\uB9C8\uB97C \uC218\uCE58\uB9CC\uD07C
      \uD68D\uB4DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173263
    m_Localized: "\uD53C\uD574\uD69F\uC218\uC5D0 \uB530\uB77C \uC218\uCE58\uAC00
      1 \uAC10\uC18C\uD55C\uB2E4. 0\uC774 \uB418\uC5C8\uC744 \uB54C \uC0B4\uC544
      \uC788\uB2E4\uBA74 \uBE14\uB86D 2\uB9C8\uB9AC\uB85C \uBD84\uC5F4\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173264
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uC218\uCE58\uAC00 1 \uAC10\uC18C\uD569\uB2C8\uB2E4.
      \uC218\uCE58\uAC00 0\uC774 \uB418\uBA74 \uB300\uD3ED\uBC1C\uC744 \uC0AC\uC6A9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173265
    m_Localized: "\uB4A4\uC5BD\uD798"
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173266
    m_Localized: "\uC774\uB3D9\uC5D0 \uC0AC\uC6A9\uD558\uB294 \uB9C8\uB098 \uC18C\uBAA8\uB7C9\uC774
      2\uBC30\uAC00 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173267
    m_Localized: "\uB9C8\uB098 \uC7AC\uC0DD\uB7C9\uC744 \uC218\uCE58\uB9CC\uD07C
      \uBCC0\uD654\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173268
    m_Localized: "\uCCAB \uC774\uB3D9\uC758 \uB9C8\uB098 \uC0AC\uC6A9\uB7C9\uC744
      \uC218\uCE58\uB9CC\uD07C \uBCC0\uD654\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173269
    m_Localized: "\uACF5\uACA9\uD0C0\uC785 \uAE30\uC5B5\uC758 \uB9C8\uB098 \uC0AC\uC6A9\uB7C9\uC744
      \uC218\uCE58\uB9CC\uD07C \uBCC0\uD654\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173270
    m_Localized: "\uB514\uBC84\uD504\uD0C0\uC785 \uAE30\uC5B5\uC758 \uB9C8\uB098
      \uC0AC\uC6A9\uB7C9\uC744 \uC218\uCE58\uB9CC\uD07C \uBCC0\uD654\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173271
    m_Localized: "\uC774\uB3D9\uC774 \uCF54\uC2A4\uD2B8\uB97C \uC18C\uBAA8\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173272
    m_Localized: "\uB9C8\uC2A4\uD06C\uC5D0 \uD3EC\uD568\uB41C \uC2AC\uB86F\uC5D0
      \uAE30\uC5B5\uC744 \uB4F1\uB85D\uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173273
    m_Localized: "\uAE30\uC5B5\uC744 \uB4F1\uB85D\uD560 \uC218 \uC788\uB294 \uC2AC\uB86F
      \uC218\uB97C \uC218\uCE58\uB85C \uC81C\uD55C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173274
    m_Localized: "\uD574\uB2F9 \uC2AC\uB86F\uC5D0\uC11C \uC774\uB3D9\uD558\uC9C0
      \uC54A\uC558\uB2E4\uBA74 \uBC84\uD504\uD0C0\uC785 \uAE30\uC5B5\uC758 \uB9C8\uB098
      \uC0AC\uC6A9\uB7C9\uC744 \uC218\uCE58\uB9CC\uD07C \uBCC0\uD654\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10187665093173275
    m_Localized: "\uD574\uB2F9 \uC2AC\uB86F\uC5D0\uC11C \uC774\uB3D9\uD55C \uB4A4
