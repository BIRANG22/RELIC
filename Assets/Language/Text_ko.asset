      m_Items: []
  - m_Id: 10173380904362056
    m_Localized: "\uC5F0\uCD9C \uAC15\uC81C \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380904362057
    m_Localized: "\uCCB4\uD06C\uD558\uBA74 \uC774 \uC561\uC158\uC774 \uC2E4\uD589\uB41C
      \uB4A4 \uC9C0\uC815\uD55C \uB51C\uB808\uC774 \uD6C4 \uC778\uD2B8\uB85C \uC5F0\uCD9C\uC744
      \uAC15\uC81C\uB85C \uC885\uB8CC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380904362058
    m_Localized: "\uAC15\uC81C \uC885\uB8CC\uAE4C\uC9C0 \uAE30\uB2E4\uB9B4 \uC2DC\uAC04\uC785\uB2C8\uB2E4.
      Time Scale\uC758 \uC601\uD5A5\uC744 \uBC1B\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556288
    m_Localized: "\uC778\uD2B8\uB85C UI"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556289
    m_Localized: "\uBC30\uACBD\uACFC \uD14D\uC2A4\uD2B8\uB97C \uD3EC\uD568\uD55C
      \uC778\uD2B8\uB85C \uC804\uCCB4 \uB8E8\uD2B8\uC785\uB2C8\uB2E4. \uD3C9\uC18C\uC5D0\uB294
      \uC790\uB3D9\uC73C\uB85C \uBE44\uD65C\uC131\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556290
    m_Localized: "\uD0C0\uC790 \uD6A8\uACFC\uAC00 \uC801\uC6A9\uB420 \uD14D\uC2A4\uD2B8\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556291
    m_Localized: "\uC778\uD2B8\uB85C UI\uC758 \uC815\uB82C \uC21C\uC11C\uC785\uB2C8\uB2E4.
      \uC77C\uBC18 UI/\uC635\uC158/\uC77C\uC2DC\uC815\uC9C0\uBCF4\uB2E4 \uC55E\uC5D0,
      \uC52C \uC804\uD658\uBCF4\uB2E4 \uB4A4\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4.
      \uC548\uC804\uD55C Canvas \uC815\uB82C \uBC94\uC704 \uC548\uC5D0\uC11C 31000~31500\uC73C\uB85C
      \uC81C\uD55C\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556292
    m_Localized: "\uC778\uD2B8\uB85C \uBB38\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556293
    m_Localized: "\uC21C\uC11C\uB300\uB85C \uD45C\uC2DC\uD560 \uBB38\uC7A5\uC785\uB2C8\uB2E4.
      \uD55C \uD56D\uBAA9\uC774 \uD55C \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556294
    m_Localized: "\uC6D0\uC778 \uBAA8\uB97C \uC7AC\uC559 \uC774\uD6C4, \uC7BF\uAC00\uB8E8\uB294
      \uC138\uACC4\uB97C \uB4A4\uB36E\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556295
    m_Localized: "\uADF8\uB9AC\uACE0 \uC7BF\uAC00\uB8E8\uC5D0 \uCE68\uC2DD\uB41C
      \uAD6C\uC5ED \uC548\uC5D0\uC11C \uBCC0\uC774\uCCB4\uB4E4\uC774 \uB098\uD0C0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556296
    m_Localized: "\uBB38\uC7A5\uBCC4 \uC5F0\uCD9C"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380908556297
    m_Localized: "\uBB38\uC7A5\uC774 \uD45C\uC2DC\uB418\uB294 \uC21C\uAC04 \uC2E4\uD589\uD560
