  - m_Id: 11677536462839941
    m_Localized: "\uBAA8\uB4E0 \uBC94\uC704\uC5D0 {ValueRate1}\uC758 \uD53C\uD574\uB97C
      \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839942
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C {ValueRate1}\uB9CC\uD07C \uBC29\uC5B4\uB3C4\uB97C
      \uBD80\uC5EC\uD55C\uB2E4."
