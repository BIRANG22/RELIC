    m_Metadata:
      m_Items: []
  - m_Id: 10173380904362052
    m_Localized: "\uCCB4\uD06C\uD558\uBA74 Local Position/Rotation\uC744 \uC0AC\uC6A9\uD558\uACE0,
      \uB044\uBA74 World Position/Rotation\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.
      Scale\uC740 \uD56D\uC0C1 Local Scale\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380904362053
    m_Localized: "\uC560\uB2C8\uBA54\uC774\uC158 \uC2DC\uC791 \uC804 \uB300\uAE30
