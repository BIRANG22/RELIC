  - m_Id: 11677536462839940
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C {ValueRate1}\uC758 \uD53C\uD574\uB97C
      \uC8FC\uACE0, {ValueRate2}\uCE78 \uBC00\uCCD0\uB0B8\uB2E4."
