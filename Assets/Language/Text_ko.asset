    m_Localized: "\uC120\uD0DD\uD55C \uADF8\uB9AC\uB4DC\uC758 \uC544\uAD70\uACFC
      \uC704\uCE58\uB97C \uBCC0\uACBD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186338
    m_Localized: Uncommon
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186339
    m_Localized: "\uB3C5\uC8FC\uBA38\uB2C8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186340
    m_Localized: "\uC120\uD0DD\uD55C \uADF8\uB9AC\uB4DC\uC5D0 \uB3C5 \uC7A5\uD310\uC744
      \uC0DD\uC131\uD569\uB2C8\uB2E4. \uB3C5 \uC7A5\uD310 \uC704\uB97C \uC774\uB3D9\uD558\uBA74
      \uC911\uB3C5 2\uB97C \uBD80\uC5EC\uD558\uACE0 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186341
    m_Localized: Uncommon
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186342
    m_Localized: "\uD734\uB300\uC6A9 \uACF0\uB36B"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186343
    m_Localized: "\uC120\uD0DD\uD55C \uADF8\uB9AC\uB4DC\uC5D0 \uAC00\uC2DC \uC7A5\uD310\uC744
      \uC0DD\uC131\uD569\uB2C8\uB2E4. \uAC00\uC2DC \uC7A5\uD310 \uC704\uB97C \uC774\uB3D9\uD558\uBA74
      \uD53C\uD574 3\uC744 \uBC1B\uC73C\uBA70, \uC804\uD22C\uAC00 \uC885\uB8CC\uB420
      \uB54C\uAE4C\uC9C0 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186344
    m_Localized: Uncommon
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186345
    m_Localized: "\uC800\uC8FC\uC778\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186346
    m_Localized: "\uC120\uD0DD\uD55C \uADF8\uB9AC\uB4DC\uC758 \uC801\uC740 \uC774\uBC88
      \uD134 \uB3D9\uC548 \uC8FC\uB294 \uD53C\uD574\uAC00 50% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186347
    m_Localized: Uncommon
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186348
    m_Localized: "\uAC04\uC774 \uBC14\uB9AC\uAC8C\uC774\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186349
    m_Localized: "\uC120\uD0DD\uD55C \uBE48 \uADF8\uB9AC\uB4DC\uC5D0 \uC7A5\uC560\uBB3C\uC744
      \uC0DD\uC131\uD569\uB2C8\uB2E4. \uC804\uD22C\uAC00 \uC885\uB8CC\uB420 \uB54C\uAE4C\uC9C0
      \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186350
    m_Localized: Uncommon
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186351
    m_Localized: "\uB4DC\uB77C\uC774\uBC84"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186352
    m_Localized: "\uC120\uD0DD\uD55C \uADF8\uB9AC\uB4DC\uC758 \uC7A5\uC560\uBB3C\uC744
      \uC81C\uAC70\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186353
    m_Localized: Uncommon
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186354
    m_Localized: "\uBC00\uC9DA \uD5C8\uC218\uC544\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186355
    m_Localized: "\uC120\uD0DD\uD55C \uBE48 \uADF8\uB9AC\uB4DC\uC5D0 \uD5C8\uC218\uC544\uBE44\uB97C
      \uC18C\uD658\uD569\uB2C8\uB2E4. \uD5C8\uC218\uC544\uBE44\uB294 \uC801\uC758
      \uACF5\uACA9 \uB300\uC0C1\uC774 \uB418\uBA70, \uD53C\uD574\uB97C \uBC1B\uC73C\uBA74
      \uD30C\uAD34\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186356
    m_Localized: Uncommon
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186357
    m_Localized: "\uD0DC\uC5FD \uD3ED\uD0C4 \uC778\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186358
    m_Localized: "\uC120\uD0DD\uD55C \uBE48 \uADF8\uB9AC\uB4DC\uC5D0 \uD3ED\uBC1C
      \uC778\uD615\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uD3ED\uBC1C \uC778\uD615\uC740
      5\uBC88 \uC2AC\uB86F\uC758 \uD589\uB3D9\uC774 \uB05D\uB098\uBA74 \uD3ED\uBC1C\uD558\uC5EC
      \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uACE0\uC815\uD53C\uD574 4\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186359
    m_Localized: Uncommon
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186360
    m_Localized: "\uBA38\uD06C\uC758 \uC824"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186361
    m_Localized: A
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186362
    m_Localized: "\uB048\uC801\uD55C \uBA38\uD06C\uC758 \uC824\uC774\uB2E4. \uD310\uB9E4
      \uC2DC 15 \uB354\uC2A4\uD2F0\uC6C0\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186363
    m_Localized: "\uBE14\uB85D\uC758 \uC810\uC561"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186364
    m_Localized: B
    m_Metadata:
      m_Items: []
