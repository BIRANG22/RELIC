      m_Items: []
  - m_Id: 9164888147097975825
    m_Localized: "\uD6C4\uBC29\uC5D0\uC11C \uACF5\uACA9\uD560 \uB54C \uD53C\uD574\uAC00
      30% \uC99D\uAC00\uD55C\uB2E4."
