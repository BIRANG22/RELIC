      m_Items: []
  - m_Id: 21894353345060865
    m_Localized: "\uCC98\uCE58\uD55C \uC801 1\uBA85\uB2F9 \uCE74\uB974\uB9C8\uB97C
      \uC218\uCE58 \uD68D\uB4DD\uD55C\uB2E4."
