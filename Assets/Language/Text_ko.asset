      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380904362054
    m_Localized: "\uBAA9\uD45C Transform\uAE4C\uC9C0 \uC774\uB3D9\uD558\uB294 \uC2DC\uAC04\uC785\uB2C8\uB2E4.
