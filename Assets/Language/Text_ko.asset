      m_Items: []
  - m_Id: 11677536462839943
    m_Localized: "\uBC94\uC704 \uB0B4\uC5D0 \uCE90\uB9AD\uD130\uAC00 \uB4E4\uC5B4\uC624\uBA74
      1\uCE78 \uB3C4\uB9DD\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839944
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C {ValueRate1}\uC758 \uAD00\uD1B5 \uD53C\uD574\uB97C
