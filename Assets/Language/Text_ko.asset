  - m_Id: 17062766837243950
    m_Localized: "\uD734\uC2DD \uAD6C\uC5ED"
    m_Metadata:
      m_Items: []
  - m_Id: 17062766837243951
    m_Localized: "\uC81C1\uAD6C\uC5ED \uD3D0\uD5C8"
    m_Metadata:
      m_Items: []
  - m_Id: 17062766837243952
    m_Localized: "\uAC15\uD654 \uAC00\uB2A5\uD55C \uC7A5\uCC29 \uAE30\uC5B5\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17062766837243953
    m_Localized: "\uAE30\uC5B5 \uAC15\uD654 \uC120\uD0DD \uD328\uB110\uC744 \uC5F4
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17062766837243954
    m_Localized: "\uBA40\uD2F0\uD50C\uB808\uC774 \uB85C\uBE44\uC5D0\uC11C\uB294 \uD638\uC2A4\uD2B8\uB9CC
      \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17062766837243955
    m_Localized: "\uC804\uD22C \uC9C0\uC5ED \uC9C4\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 17105354709540953
    m_Localized: "\uC77C\uBC18"
    m_Metadata:
      m_Items: []
  - m_Id: 17105354709540954
    m_Localized: "\uB808\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 17105354709540955
    m_Localized: "\uC5D0\uD53D"
    m_Metadata:
      m_Items: []
  - m_Id: 17105354709540956
    m_Localized: "\uC720\uB2C8\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986885
    m_Localized: "\uD134 \uC2DC\uC791 \uC2DC \uCE74\uB974\uB9C8\uAC00 \uCD5C\uB300\uB77C\uBA74
      \uCD5C\uB300 \uC0DD\uBA85\uB825 \uB300\uBE44 \uC0DD\uBA85\uB825\uC774 \uB0AE\uC740
      \uC544\uAD70\uC758 \uC0DD\uBA85\uB825\uC744 1 \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986888
    m_Localized: "\uC131\uACF5 \uD655\uB960 30%\n\uC131\uACF5: \uC120\uD0DD\uD55C
      \uAE30\uC5B5 1\uAC1C \uAC01\uC131\n\uC2E4\uD328: \uC120\uD0DD\uD55C \uAE30\uC5B5
      \uC18C\uBA78"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986895
    m_Localized: "\uB0A1\uC740 \uC0C1\uC790\uC640 \uC815\uCCB4\uB97C \uC54C \uC218
      \uC5C6\uB294 \uC758\uC2DD \uB3C4\uAD6C\uB4E4\uC774 \uC5B4\uC9C0\uB7FD\uAC8C
      \uB193\uC5EC \uC788\uB2E4. \uC544\uC9C1 \uC758\uC2DD\uC758 \uD754\uC801\uC774
      \uC120\uBA85\uD558\uAC8C \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986896
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815\n\uB192\uC744\uC218\uB85D \uCD5C\uB300
      \uC0DD\uBA85\uB825 \uC99D\uAC00\uB7C9 \uC0C1\uC2B9"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986897
    m_Localized: "\uC131\uACF5 \uD655\uB960 90%\n\uC131\uACF5: \uC120\uD0DD\uD55C
      \uAE30\uC5B5 1\uAC1C \uAC01\uC131\n\uC2E4\uD328: \uC120\uD0DD\uD55C \uAE30\uC5B5
      \uC18C\uBA78"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986906
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uAC15\uB825\uD55C \uCC38\uACA9\uC744
      \uAC00\uD558\uC5EC\n7\uC758 \uD53C\uD574\uB97C \uC8FC\uBA70 1\uCE78 \uBC00\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986914
    m_Localized: "1. 5\uAC1C\uC758 \uC2AC\uB86F \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD55C\uB2E4.\n2.
      \uCE90\uB9AD\uD130 \uB610\uB294 HUD\uB97C \uD074\uB9AD\uD558\uC5EC \uCE90\uB9AD\uD130\uC758
      \uC2A4\uD0AC \uB9AC\uC2A4\uD2B8\uB97C \uC5F0\uB2E4.\n3. \uC774\uB3D9\uC2A4\uD0AC\uC740
      \uC120\uD0DD\uD55C \uD6C4 \uC774\uB3D9\uD560 \uADF8\uB9AC\uB4DC\uB97C \uCD94\uAC00\uB85C
      \uC120\uD0DD\uD55C\uB2E4.\n4. \uACF5\uACA9,\uBC84\uD504\uC2A4\uD0AC\uC740 \uC9C4\uD589\uBC29\uD5A5\uC73C\uB85C
      \uC790\uB3D9 \uB4F1\uB85D\uB41C\uB2E4.\n3. \uBCF4\uC720\uD55C \uC790\uC6D0\uC744
      \uC0AC\uC6A9\uD558\uC5EC \uC2A4\uD0AC\uC744 \uB4F1\uB85D\uD558\uACE0 \uD134\uC5D4\uB4DC\uB97C
      \uD55C\uB2E4.\n\n\n- \uD0C0\uC784\uB77C\uC778\uC5D0 \uB9C8\uC6B0\uC2A4\uD638\uBC84\uB97C
      \uD558\uC5EC \uD589\uB3D9\uB300\uC0C1\uACFC \uC9C4\uD589\uD589\uB3D9\uC758
      \uC815\uBCF4\uB97C \uC54C \uC218 \uC788\uB2E4.\n- \uD0C0\uC784\uB77C\uC778\uC758
      \uB4F1\uB85D\uC2A4\uD0AC\uC744 \uD074\uB9AD\uD558\uC5EC \uB4F1\uB85D\uC744
      \uCDE8\uC18C\uD560 \uC218 \uC788\uB2E4.\n- \uBAAC\uC2A4\uD130\uB97C \uD074\uB9AD\uD558\uC5EC
      HUD\uC640 \uBCF4\uC720 \uBC84\uD504/\uB514\uBC84\uD504\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uB2E4.\n- \uCE90\uB9AD\uD130 HUD\uC758 \uC544\uC774\uCF58\uC5D0
      \uB9C8\uC6B0\uC2A4\uD638\uBC84\uB97C \uD558\uC5EC \uBC84\uD504/\uB514\uBC84\uD504\uB97C
      \uD655\uC778\uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986919
    m_Localized: "[\uCE68\uC2DD\uC774 \uC9D9\uC5B4\uC9C8\uC218\uB85D, \uB354 \uB9CE\uC740
      \uC794\uC7AC\uAC00 \uB0A8\uB294\uB2E4]"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986920
    m_Localized: "[\uC62C\uBC14\uB978 \uC870\uD569\uB9CC\uC774, \uC0C8\uB85C\uC6B4
      \uC131\uC9C8\uC744 \uB9CC\uB4E4\uC5B4\uB0B8\uB2E4]"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986921
    m_Localized: "[\uD758\uB824\uBCF4\uB0B8 \uD798\uC740, \uC720\uBB3C\uACFC\uC758
      \uACF5\uBA85\uC744 \uC774\uB8EC\uB2E4]"
    m_Metadata:
      m_Items: []
  - m_Id: 17117632292986922
    m_Localized: "\uC7AC\uD654 \uD68D\uB4DD\uB7C9 +{0}% / \uACBD\uD5D8\uCE58 \uD68D\uB4DD\uB7C9
      +{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100852
    m_Localized: "\uCDE8\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100853
