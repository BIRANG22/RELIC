  - m_Id: 10173380895973449
    m_Localized: "\uC561\uD2F0\uBE0C \uC720\uBB3C \uC2AC\uB86F"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973450
    m_Localized: "\uC720\uBB3C \uC2AC\uB86F {slotIndex + 1}"
