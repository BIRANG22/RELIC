  - m_Id: 41385915703631926
    m_Localized: "\uCF54\uC2A4\uD2B8 \uD68C\uBCF5\uB7C9\uC774 1 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631927
