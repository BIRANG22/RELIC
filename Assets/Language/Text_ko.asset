    m_Localized: C
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186368
    m_Localized: "\uB79C\uC11C\uC758 \uD798\uC774 \uB0A8\uC544 \uC788\uB294 \uCF54\uC5B4\uB2E4.
      \uD310\uB9E4 \uC2DC 12 \uB354\uC2A4\uD2F0\uC6C0\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
