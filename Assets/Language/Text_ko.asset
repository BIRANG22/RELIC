      m_Items: []
  - m_Id: 10173380895973451
    m_Localized: "Dustium\uC774 \uB0A0\uC544\uAC00 \uB3C4\uCC29\uD560 GoldHud \uC704\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973452
    m_Localized: "\uC774\uBCA4\uD2B8 \uC624\uBE0C\uC81D\uD2B8 \uC131\uACF5 \uC5F0\uCD9C\uC744
      \uBA3C\uC800 \uBCF4\uC5EC\uC900 \uB4A4 Dustium \uD68D\uB4DD \uC5F0\uCD9C\uC744
      \uC2DC\uC791\uD558\uAE30\uAE4C\uC9C0 \uAE30\uB2E4\uB9AC\uB294 \uC2DC\uAC04\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973453
    m_Localized: "Event_06\uC758 \uC624\uBE0C\uC81D\uD2B8 \uC5F0\uCD9C\uC744 \uBA3C\uC800
      \uBCF4\uC5EC\uC900 \uB4A4 \uC0C1\uC810 \uD328\uB110\uC744 \uC5F4\uAE30\uAE4C\uC9C0
      \uAE30\uB2E4\uB9AC\uB294 \uC2DC\uAC04\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973454
    m_Localized: "Event_06 \uC0C1\uC810\uC774 \uC5F4\uB9AC\uACE0 \uB2EB\uD790 \uB54C
      EventRoom\uC758 TITLE/\uC120\uD0DD\uC9C0 UI\uAC00 \uD398\uC774\uB4DC\uB418\uB294
      \uC2DC\uAC04\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973455
    m_Localized: "\uC8FC\uC0AC\uC704 \uC2A4\uD0EF \uD31D\uC5C5\uC774 \uB05D\uB09C
      \uB4A4 Event_01_A/B/C \uACB0\uACFC Title\uB85C \uB118\uC5B4\uAC00\uAE30\uAE4C\uC9C0
      \uAE30\uB2E4\uB9AC\uB294 \uC2DC\uAC04\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973456
    m_Localized: "\u201C\uC870\uAE08\uC774\uB098\uB9C8 \uB3C4\uC6C0\uC774 \uB418\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4. \uBD80\uB514 \uC870\uC2EC\uD574\uC11C \uC0AC\uC6A9\uD574
      \uC8FC\uC138\uC694.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973457
    m_Localized: "\u201C\uC0C1\uCC98\uAC00 \uC870\uAE08\uC740 \uB098\uC544\uC84C\uAD70\uC694.
      \uC774 \uD798\uC774 \uB2F9\uC2E0\uB4E4\uC758 \uC5EC\uC815\uC5D0 \uBCF4\uD0EC\uC774
      \uB418\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973458
    m_Localized: "\u201C\uB2F9\uC2E0\uB4E4\uC758 \uC0DD\uBA85\uC5D0 \uCD95\uBCF5\uC774
      \uBA38\uBB3C\uAE30\uB97C. \uC55E\uC73C\uB85C\uC758 \uAE38\uC774 \uC870\uAE08\uC740
      \uB35C \uACE0\uB418\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973459
    m_Localized: "\uD55C \uBC88 \uB354 \uC190\uC744 \uBED7\uC744 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973460
    m_Localized: "\uC758\uC2DD \uB3C4\uAD6C\uC5D0 \uB0A8\uC544 \uC788\uB358 \uD798\uC774
      \uBAB8 \uC548\uC73C\uB85C \uC2A4\uBA70\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973461
    m_Localized: "\uD754\uC801\uC744 \uD5E4\uC9D1\uC790 \uC548\uCABD\uC5D0\uC11C
      \uAC15\uD55C \uD798\uC744 \uBA38\uAE08\uC740 \uC720\uBB3C\uC774 \uBAA8\uC2B5\uC744
      \uB4DC\uB7EC\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973462
    m_Localized: "\uC758\uC2DD \uB3C4\uAD6C\uC5D0 \uC190\uC744 \uB300\uB294 \uC21C\uAC04
      \uBD88\uAE38\uD55C \uAE30\uC6B4\uC774 \uC5ED\uB958\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973463
    m_Localized: "\uD754\uC801\uC744 \uD6FC\uC190\uD55C \uC21C\uAC04 \uC5B5\uB20C\uB824
      \uC788\uB358 \uD798\uC774 \uD3ED\uBC1C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973464
    m_Localized: "\uB354 \uC774\uC0C1 \uC190\uB300\uC9C0 \uC54A\uAE30\uB85C \uD558\uACE0,
      \uC870\uC6A9\uD788 \uC790\uB9AC\uB97C \uB5A0\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973465
    m_Localized: "\uB73B\uBC16\uC758 \uC218\uD655\uC744 \uC5BB\uC5C8\uB2E4. \uB354
      \uC774\uC0C1 \uC190\uB308 \uAC83\uC740 \uC5C6\uC5B4 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973466
    m_Localized: "\uC608\uC0C1\uCE58 \uBABB\uD55C \uD3ED\uBC1C\uC5D0 \uD718\uB9D0\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973467
    m_Localized: "\u201C\uC88B\uC544. \uB300\uAC00\uB294 \uCDA9\uBD84\uD558\uAD70.
      \uC57D\uC18D\uD55C \uBB3C\uAC74\uC740 \uC5EC\uAE30 \uC788\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973468
    m_Localized: "\u201C\uC81C\uBC95 \uC6B4\uC774 \uC88B\uC558\uAD70. \uC774 \uBB3C\uAC74\uC740
      \uB124 \uBAAB\uC774\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973469
    m_Localized: "\u201C\uB098\uC058\uC9C0 \uC54A\uC740 \uAC70\uB798\uC600\uC5B4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10173380895973470
    m_Localized: "\u201C\uAC12\uC744 \uCE58\uB97C \uCC28\uB840\uB2E4. \uBAA8\uC790\uB780
      \uBAAB\uC740 \uC0DD\uBA85\uC73C\uB85C \uBC1B\uC544\uAC00\uACA0\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
