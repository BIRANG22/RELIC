  - m_Id: 41387432259100750
    m_Localized: "\uD589\uB3D9\uBC94\uC704"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100751
    m_Localized: "\uD589\uB3D9\uD2B9\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100752
    m_Localized: "\uAC15\uD654\uAC00\uB2A5\uC2A4\uD0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100753
    m_Localized: "\uAC15\uD654\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100756
    m_Localized: "\uD328\uC2DC\uBE0C\uC2A4\uD0AC\uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100757
    m_Localized: "\uAC8C\uC784\uC744 \uC885\uB8CC\uD558\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100760
    m_Localized: "\uBC30\uC591\uC870 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100761
    m_Localized: "\uC7AC\uB8CC \uD22C\uC785\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100762
    m_Localized: "\uBE44\uC5B4 \uC788\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100763
    m_Localized: "\uC870\uD569\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100775
    m_Localized: "\uC2A4\uD0AC \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100776
    m_Localized: "\uAC00\uBC29\uC774 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4. \uC11C\uB85C
      \uB2E4\uB978 \uC544\uC774\uD15C\uC740 \uCD5C\uB300 {0}\uC885\uB958\uAE4C\uC9C0
      \uBCF4\uC720\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915657494528
    m_Localized: "\uD790\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466048
    m_Localized: "\u201C\uAC15\uD55C \uB188\uB4E4\uC774 \uB4DD\uC2E4\uAC70\uB9B0\uB2E4\uBA70?
      \uADF8\uB7FC \uB0B4\uAC00 \uAC00\uC57C\uC9C0.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466049
    m_Localized: "\uCE74\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466050
    m_Localized: "\u201C\uC784\uBB34\uB77C\uBA74 \uC644\uC218\uD55C\uB2E4. \uADF8\uBFD0\uC774\uC57C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466051
    m_Localized: "\uD5E4\uC774\uC988"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466052
    m_Localized: "\u201C\uC815\uB9D0 \uC81C\uAC00 \uAC00\uC57C \uD558\uB294 \uAC74\uAC00\uC694?\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466053
    m_Localized: "\uC774\uB124\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466054
    m_Localized: "\u201C\uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694. \uBAA8\uB450
      \uBB34\uC0AC\uD788 \uB3CC\uC544\uAC08 \uC218 \uC788\uB3C4\uB85D \uD560\uAC8C\uC694.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466056
    m_Localized: "\u201C\uADF8\uB0E5 \uB0B4\uAC00 \uAC00\uACE0 \uC2F6\uC5B4\uC11C
      \uAC00\uB294 \uAC70\uC57C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466057
    m_Localized: "\uBA38\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466060
    m_Localized: "\uBE14\uB86D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466063
    m_Localized: "\uB79C\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466066
    m_Localized: "\uBE14\uB77C\uC774\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466069
    m_Localized: "\uBCA0\uC2A4\uD30C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466072
    m_Localized: "\uC2E0\uB354"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466075
    m_Localized: "\uB4DC\uB77C\uC6B0\uADF8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466078
    m_Localized: "\uBC14\uB85C\uC6B0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466081
    m_Localized: "\uB8E8\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466084
    m_Localized: "\uB179\uD134"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466087
    m_Localized: "\uBAA8\uB974\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466129
    m_Localized: "\uC6A9\uC758 \uAC00\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048991
    m_Localized: "\uC6A9\uB9B0\xB7\uBD84\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048992
    m_Localized: "1\uD134 \uC2DC\uC791 \uC2DC \uC7A5\uB9C9\uC744 {ValueRate1} \uD68D\uB4DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048993
    m_Localized: "\uC6A9\uB9B0\xB7\uACA9\uC559"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048994
    m_Localized: "\uC0DD\uBA85\uB825 \uD68C\uBCF5 \uC2DC \uCD08\uACFC\uD55C \uC218\uCE58\uB9CC\uD07C
      \uBC29\uC5B4\uB3C4\uB97C \uD68D\uB4DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048995
    m_Localized: "\uC6A9\uB9B0\xB7\uC218\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048996
    m_Localized: "\uD134 \uC2DC\uC791 \uC2DC \uBC29\uC5B4\uB3C4\uAC00 {ValueRate1}
      \uC774\uC0C1\uC774\uB77C\uBA74 \uAC15\uD0C0 1\uC744 \uD68D\uB4DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048997
    m_Localized: "\uC6A9\uB9B0\xB7\uACA9\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048998
    m_Localized: "\uB9E4 \uD134 \uC2DC\uC791 \uC2DC \uC0DD\uBA85\uB825 3\uC744 \uC783\uACE0
      \uC99D\uD3ED {ValueRate1}\uC744 \uD68D\uB4DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048999
    m_Localized: "\uC6A9\uB9B0\xB7\uB9F9\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691049000
    m_Localized: "\uD604\uC7AC \uC0DD\uBA85\uB825\uC774 50% \uC774\uD558\uB77C\uBA74
      \uC8FC\uB294 \uD53C\uD574\uAC00 {ValueRate1}% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691049001
    m_Localized: "\uAC80\uC2EC\xB7\uC608\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631872
    m_Localized: "\uC804\uD22C\uC5D0\uC11C \uCC98\uC74C \uB4F1\uB85D\uD55C \uACF5\uACA9
      \uAE30\uC5B5\uC758 \uACF5\uACA9 \uD69F\uC218\uAC00 {ValueRate1}\uD68C \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631873
    m_Localized: "\uAC80\uC2EC\xB7\uC808\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631874
    m_Localized: "\uC5F0\uC18D \uB4F1\uB85D\uD55C \uACF5\uACA9 \uC218\uB9CC\uD07C
      \uB9C8\uC9C0\uB9C9 \uACF5\uACA9 \uB4A4\uC5D0 \uAD00\uD1B5 \uD53C\uD574\uB97C
      \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631875
    m_Localized: "\uAC80\uC2EC\xB7\uC5F0\uBB34"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631876
    m_Localized: "\uACF5\uACA9 \uD69F\uC218\uAC00 {CountRate1}\uD68C \uC774\uC0C1\uC778
      \uAE30\uC5B5\uC758 \uD53C\uD574\uAC00 {ValueRate1} \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631877
    m_Localized: "\uAC80\uC2EC\xB7\uC77C\uC12C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631878
    m_Localized: "\uAD00\uD1B5 \uD53C\uD574 \uC801\uC911 \uC2DC \uB300\uC0C1\uC5D0\uAC8C
      \uCD9C\uD608\uC744 {ValueRate1} \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631879
    m_Localized: "\uAC80\uC2EC\xB7\uC9C8\uD48D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631880
    m_Localized: "\uACF5\uACA9 \uB300\uC0C1\uC774 \uC801 1\uBA85\uBFD0\uC774\uB77C\uBA74
      \uD53C\uD574\uAC00 {ValueRate1} \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631881
    m_Localized: "\uBD88\uC528\xB7\uC810\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631882
    m_Localized: "1\uD134 \uC2DC\uC791 \uC2DC \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uC57D\uD654\uB97C
      {ValueRate1} \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631883
    m_Localized: "\uBD88\uC528\xB7\uC628\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631884
    m_Localized: "\uBC84\uD504 \uB610\uB294 \uB514\uBC84\uD504 \uBD80\uC5EC \uC2DC
      \uC2E4\uC81C \uBD80\uC5EC\uD55C \uC218\uCE58\uB9CC\uD07C \uBC29\uC5B4\uB3C4\uB97C
      \uD68D\uB4DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631885
    m_Localized: "\uBD88\uC528\xB7\uAD11\uD718"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631886
    m_Localized: "\uC790\uC2E0\uACFC \uC778\uC811\uD55C \uC544\uAD70\uC5D0\uAC8C
      \uBD80\uC5EC\uD558\uB294 \uBC84\uD504 \uC218\uCE58\uAC00 {ValueRate1} \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631887
    m_Localized: "\uBD88\uC528\xB7\uC758\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631888
    m_Localized: "\uC801\uC5D0\uAC8C \uB514\uBC84\uD504 \uBD80\uC5EC \uC2DC \uCD94\uAC00\uB85C
      \uC911\uB3C5\uC744 {ValueRate1} \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631889
    m_Localized: "\uBD88\uC528\xB7\uD655\uC0B0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631890
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uB9C8\uB098\uAC00 0\uC774\uBA74 \uB2E4\uC74C
      \uD134 \uCCAB \uB4F1\uB85D \uAE30\uC5B5\uC758 \uB9C8\uB098 \uC18C\uBAA8\uAC00
      0\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631891
    m_Localized: "\uC740\uCD1D\xB7\uC2E0\uC2EC"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631892
