      m_Items: []
  - m_Id: 29511573945163776
    m_Localized: "================================\n\n\uB370\uBAA8 \uBC84\uC804 \uD50C\uB808\uC774
      \uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\n\uD604\uC7AC \uBC84\uC804\uC5D0\uC11C \uAD6C\uD604\uB41C
      \uB0B4\uC6A9\n\n- \uB9F5 \uC0DD\uC131\n- \uCE90\uB9AD\uD130 \uD3B8\uC131\n-
      \uC804\uD22C \uC2DC\uC2A4\uD15C\n- \uBAAC\uC2A4\uD130 AI\n- \uC2A4\uD0AC \uBC0F
      \uC0C1\uD0DC\uC774\uC0C1\n- \uD134 \uC608\uC57D \uC2DC\uC2A4\uD15C\n\n\uBCF4\uC2A4\uC804
      \uBC0F \uD6C4\uBC18 \uCEE8\uD150\uCE20\uB294\n\uAC1C\uBC1C \uC9C4\uD589 \uC911\uC785\uB2C8\uB2E4.\n\n================================"
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975811
