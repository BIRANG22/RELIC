  - m_Id: 11677536462839960
    m_Localized: "\uC544\uB4DC\uB808\uB0A0\uB9B0"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839961
    m_Localized: "\uC774\uBC88 \uD134 \uB3D9\uC548 \uACF5\uACA9 \uAE30\uC5B5\uC758
      \uD53C\uD574\uB7C9\uC774 100% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839962
    m_Localized: "\uACBD\uD654\uC81C \uC570\uD50C"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034112
    m_Localized: "\uC751\uCD95 \uC5D0\uD14C\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034113
    m_Localized: "\uCE74\uB974\uB9C8\uB97C 3 \uD68C\uBCF5\uD55C\uB2E4. \uD604\uC7AC
      \uCE74\uB974\uB9C8\uC640 \uC608\uC57D\uB41C \uCE74\uB974\uB9C8\uB97C \uD569\uD55C
      \uAC12\uC740 \uCD5C\uB300\uCE58\uB97C \uCD08\uACFC\uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034114
    m_Localized: "\uB9C8\uB098\uB97C 10 \uD68C\uBCF5\uD55C\uB2E4. \uCD5C\uB300\uCE58\uB97C
      \uCD08\uACFC\uD558\uC5EC \uBCF4\uC720\uD560 \uC218 \uC788\uC73C\uBA70, \uCD08\uACFC\uD55C
      \uB9C8\uB098\uB294 \uB2E4\uC74C \uD134\uC5D0 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034115
    m_Localized: "\uAC01\uC131\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034116
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C \uC2E0\uC18D 2\uB97C \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034117
    m_Localized: "\uB9D1\uC740 \uBB3C\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034118
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C \uBD80\uC5EC\uB41C \uBAA8\uB4E0 \uB514\uBC84\uD504\uB97C
      \uC81C\uAC70\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034119
    m_Localized: "\uC120\uD0DD\uD55C \uBE48 \uADF8\uB9AC\uB4DC\uB85C \uC774\uB3D9\uD55C\uB2E4.
      \uC774\uB3D9 \uD6C4 \uC608\uC57D\uD55C \uC774\uB3D9 \uBC0F \uACF5\uACA9 \uD589\uB3D9\uC740
      \uCDE8\uC18C\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034120
    m_Localized: "\uC120\uD0DD\uD55C \uADF8\uB9AC\uB4DC\uC758 \uC544\uAD70\uACFC
      \uC704\uCE58\uB97C \uBCC0\uACBD\uD55C\uB2E4. \uC704\uCE58\uAC00 \uBCC0\uACBD\uB41C
      \uB450 \uCE90\uB9AD\uD130\uAC00 \uC608\uC57D\uD55C \uC774\uB3D9 \uBC0F \uACF5\uACA9
      \uD589\uB3D9\uC740 \uCDE8\uC18C\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034121
    m_Localized: "\uC120\uD0DD\uD55C \uC801\uC740 \uC774\uBC88 \uD134 \uB3D9\uC548
      \uC8FC\uB294 \uD53C\uD574\uAC00 50% \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034122
    m_Localized: "\uC120\uD0DD\uD55C \uBE48 \uADF8\uB9AC\uB4DC\uC5D0 \uC794\uD574\uB97C
      \uC0DD\uC131\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11697455342559232
    m_Localized: "\uC5F0\uC131\uC81C"
    m_Metadata:
      m_Items: []
