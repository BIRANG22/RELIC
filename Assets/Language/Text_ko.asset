      m_Items: []
  - m_Id: 9164888147097975826
    m_Localized: "\uC0AC\uB839\uC220"
    m_Metadata:
      m_Items: []
  - m_Id: 9164888147097975827
    m_Localized: "\uC720\uACE8\uC774 \uB41C \uBCC0\uC774\uCCB4\uB97C \uCD5C\uB300
      \uC0DD\uBA85\uB825\uC758 30%\uB85C \uBD80\uD65C\uC2DC\uD0A8\uB2E4."
