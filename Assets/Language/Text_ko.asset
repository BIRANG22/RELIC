      m_Items: []
  - m_Id: 11677536462839945
    m_Localized: "\uAC00\uAE4C\uC6B4 \uB300\uC0C1\uC5D0\uAC8C {ValueRate1}\uC758
      \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839946
    m_Localized: "\uBC94\uC704 \uB0B4 \uB300\uC0C1\uC5D0\uAC8C \uCD9C\uD608\uC744
      {ValueRate1} \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839947
    m_Localized: "\uC8FD\uC740 \uBCD1\uC0AC \uD558\uB098\uB97C 30% \uCCB4\uB825\uC73C\uB85C
      \uB418\uC0B4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839948
