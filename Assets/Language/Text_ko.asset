    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510726
    m_Localized: "\u201C\uC774\uACF3\uC740 \uC624\uB798 \uBA38\uBB3C \uACF3\uC774
      \uC544\uB2D9\uB2C8\uB2E4. \uB5A0\uB098\uC2DC\uAE30 \uC804\uC5D0 \uC800\uD76C\uC758
      \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB9D0\uC500\uD574 \uC8FC\uC138\uC694.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510727
    m_Localized: "\uC138\uB77C\uD53C\uC544\uC758 \uC9C0\uC6D0"
