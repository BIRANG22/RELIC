      m_Items: []
  - m_Id: 41385915703631998
    m_Localized: "\uC900 \uD53C\uD574\uC758 30%\uB9CC\uD07C \uCCB4\uB825\uC744 \uD68C\uBCF5\uD55C\uB2E4.
