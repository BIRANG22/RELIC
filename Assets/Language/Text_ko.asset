    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826188
    m_Localized: "\uBC1B\uB294 \uBAA8\uB4E0 \uD53C\uD574\uAC00 \uC218\uCE58\uB9CC\uD07C
      \uC99D\uAC00\uD55C\uB2E4. \uD134 \uC885\uB8CC \uC2DC \uC0AC\uB77C\uC9C0\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826189
    m_Localized: "\uCC28\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826190
    m_Localized: "\uC774\uB85C\uC6B4 \uD6A8\uACFC\uB97C 1\uD68C \uBB34\uD6A8\uD654\uD55C\uB2E4.
      \uBC1C\uB3D9 \uC2DC \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826191
    m_Localized: "\uBD84\uC5F4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826192
    m_Localized: "\uD53C\uD574\uD69F\uC218\uC5D0 \uB530\uB77C \uC218\uCE58\uAC00
      1 \uAC10\uC18C\uD55C\uB2E4.  0\uC774 \uB418\uC5C8\uC744 \uB54C \uC0B4\uC544
      \uC788\uB2E4\uBA74 \uBE14\uB86D 2\uB9C8\uB9AC\uB85C \uBD84\uC5F4\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826193
    m_Localized: "\uD3ED\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826194
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uC218\uCE58\uAC00 1 \uAC10\uC18C\uD569\uB2C8\uB2E4.
      \uC218\uCE58\uAC00 0\uC774 \uB418\uBA74 \uC790\uD3ED\uC744 \uC2DC\uC804\uD558\uACE0
      \uC0AC\uB9DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826195
    m_Localized: "\uAE30\uC2B5"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826196
    m_Localized: "\uB4A4\uB97C \uACF5\uACA9\uD560 \uB54C \uD53C\uD574\uAC00 50% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826197
    m_Localized: "\uB3CC\uACA9 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826198
    m_Localized: "\uC774\uB3D9 \uD6C4 \uCC98\uC74C \uC0AC\uC6A9\uD558\uB294 \uACF5\uACA9\uC758
      \uD53C\uD574\uAC00 20% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826199
    m_Localized: "\uB9F9\uB3C5 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826200
    m_Localized: "\uC911\uB3C5\uC744 \uBD80\uC5EC\uD560 \uB54C \uC911\uB3C5 \uBD80\uC5EC\uB7C9\uC774
      2\uBC30\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826201
    m_Localized: "\uCD9C\uD608 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826202
    m_Localized: "\uCD9C\uD608\uC744 \uBD80\uC5EC\uD560 \uB54C \uCD9C\uD608 \uBD80\uC5EC\uB7C9\uC774
      2\uBC30\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826203
    m_Localized: "\uC0DD\uBA85\uB825 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826204
    m_Localized: "\uCD5C\uB300 HP\uAC00 10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826205
    m_Localized: "\uC0DD\uBA85 \uD761\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826206
    m_Localized: "\uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uCD5C\uB300 HP\uC758 5%\uB9CC\uD07C
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826207
    m_Localized: "\uC790\uC6D0 \uC21C\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826208
    m_Localized: "\uCF54\uC2A4\uD2B8 \uD68D\uB4DD\uB7C9\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826209
    m_Localized: "\uC99D\uD3ED"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826210
    m_Localized: "\uC544\uAD70\uC5D0\uAC8C \uBC84\uD504\uB97C \uBD80\uC5EC\uD560
