  - m_Id: 11981180450119750
    m_Localized: "\uBD88\uAE38\uD55C\n\uC9D5\uD6C4"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119760
    m_Localized: "\uD604\uC7AC\uD328\uB110"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119761
    m_Localized: "\uBB34\uC791\uC704 \uC720\uBB3C 1\uAC1C \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119762
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815\n\uBCF4\uC0C1 : \uC0DD\uBA85\uB825
      \uD68C\uBCF5\n\uB192\uC744\uC218\uB85D \uC0DD\uBA85\uB825 \uD68C\uBCF5\uB7C9
      \uC0C1\uC2B9"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119763
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815\n\uBCF4\uC0C1 : \uCD5C\uB300 \uC0DD\uBA85\uB825
      \uC99D\uAC00\n\uB192\uC744\uC218\uB85D \uCD5C\uB300 \uC0DD\uBA85\uB825 \uC99D\uAC00\uB7C9
      \uC0C1\uC2B9"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119764
    m_Localized: "\u201C\uC870\uAE08\uC774\uB098\uB9C8 \uB3C4\uC6C0\uC774 \uB418\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4. \uBD80\uB514 \uC870\uC2EC\uD574\uC11C \uC0AC\uC6A9\uD574
      \uC8FC\uC138\uC694.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119765
    m_Localized: "\u201C\uC0C1\uCC98\uAC00 \uC870\uAE08\uC740 \uB098\uC544\uC84C\uAD70\uC694.
      \uC774 \uD798\uC774 \uB2F9\uC2E0\uB4E4\uC758 \uC5EC\uC815\uC5D0 \uBCF4\uD0EC\uC774
      \uB418\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119766
    m_Localized: "\u201C\uB2F9\uC2E0\uB4E4\uC758 \uC0DD\uBA85\uC5D0 \uCD95\uBCF5\uC774
      \uBA38\uBB3C\uAE30\uB97C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119767
    m_Localized: "\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0 35 \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119768
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 9\n\uC131\uACF5 : \uBB34\uC791\uC704
      \uC720\uBB3C 1\uAC1C \uD68D\uB4DD\n\uC2E4\uD328 : \uD30C\uD2F0 \uC804\uC6D0
      \uD604\uC7AC \uCCB4\uB825 3 \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119769
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 11\n\uC131\uACF5 : \uB9C8\uB098
      \uC7AC\uC0DD\uB7C9 1 \uC99D\uAC00\n\uC2E4\uD328 : \uD30C\uD2F0 \uC804\uC6D0
      \uD604\uC7AC \uCCB4\uB825 3 \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119770
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 13\n\uC131\uACF5 : \uC5D0\uD53D
      \uC720\uBB3C 1\uAC1C \uD68D\uB4DD\n\uC2E4\uD328 : \uD30C\uD2F0 \uC804\uC6D0
      \uD604\uC7AC \uCCB4\uB825 5 \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180450119771
    m_Localized: "\uC758\uC2DD \uB3C4\uAD6C\uC5D0 \uB0A8\uC544 \uC788\uB358 \uD798\uC774
      \uBAB8 \uC548\uC73C\uB85C \uC2A4\uBA70\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896896
    m_Localized: "\uD754\uC801\uC744 \uD5E4\uC9D1\uC790 \uC548\uCABD\uC5D0\uC11C
      \uAC15\uD55C \uD798\uC744 \uBA38\uAE08\uC740 \uC720\uBB3C\uC774 \uBAA8\uC2B5\uC744
      \uB4DC\uB7EC\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896897
    m_Localized: "\uC758\uC2DD \uB3C4\uAD6C\uC5D0 \uC190\uC744 \uB300\uB294 \uC21C\uAC04
      \uBD88\uAE38\uD55C \uAE30\uC6B4\uC774 \uC5ED\uB958\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896898
    m_Localized: "\uD754\uC801\uC744 \uD6FC\uC190\uD55C \uC21C\uAC04 \uC5B5\uB20C\uB824
      \uC788\uB358 \uD798\uC774 \uD3ED\uBC1C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896899
    m_Localized: "\uB354 \uC774\uC0C1 \uC190\uB300\uC9C0 \uC54A\uAE30\uB85C \uD558\uACE0,
      \uC870\uC6A9\uD788 \uC790\uB9AC\uB97C \uB5A0\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896900
    m_Localized: "\uB73B\uBC16\uC758 \uC218\uD655\uC744 \uC5BB\uC5C8\uB2E4. \uB354
      \uC774\uC0C1 \uC190\uB308 \uAC83\uC740 \uC5C6\uC5B4 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896901
    m_Localized: "\uC608\uC0C1\uCE58 \uBABB\uD55C \uD3ED\uBC1C\uC5D0 \uD718\uB9D0\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896902
    m_Localized: "\uC721\uBA74\uCCB4 \uC8FC\uC0AC\uC704 3\uAC1C\uB97C \uAD74\uB824
      \uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0\uC744 \uD68D\uB4DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896903
    m_Localized: "\uC2DC\uCCB4\uB4E4 \uC0AC\uC774\uB85C \uC544\uC9C1 \uC4F8 \uB9CC\uD55C
      \uBB3C\uAC74\uC774 \uBCF4\uC774\uC9C0\uB9CC, \uB354\uBBF8 \uC548\uCABD\uC5D0\uC11C
      \uD76C\uBBF8\uD55C \uC6C0\uC9C1\uC784\uC774 \uB290\uAEF4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896904
    m_Localized: "\uBB34\uC791\uC704 \uAE30\uC5B5 1\uAC1C \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896905
    m_Localized: "\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0 50 \uC18C\uBAA8\n\uBB34\uC791\uC704
      \uC720\uBB3C 1\uAC1C \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896906
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 11\n\uC131\uACF5 : \uBB34\uC791\uC704
      \uC720\uBB3C 1\uAC1C \uD68D\uB4DD\n\uC2E4\uD328 : \uC0DD\uBA85\uB825 5 \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896907
    m_Localized: "\uBCF4\uC720 \uC720\uBB3C 1\uAC1C \uC18C\uBAA8\n\uBB34\uC791\uC704
      \uC720\uBB3C 1\uAC1C \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896908
    m_Localized: "\u201C\uC88B\uC544. \uC774 \uC815\uB3C4\uBA74 \uCDA9\uBD84\uD55C
      \uB300\uAC00\uC600\uAD70.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896909
    m_Localized: "\u201C\uC81C\uBC95 \uC6B4\uC774 \uC88B\uC558\uAD70.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896910
    m_Localized: "\u201C\uB098\uC058\uC9C0 \uC54A\uC740 \uAC70\uB798\uC600\uC5B4..\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896911
    m_Localized: "\"\uBAA8\uC790\uB780 \uBAAB\uC740 \uC0DD\uBA85\uC73C\uB85C \uBC1B\uC544\uAC00\uACA0\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896912
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 8\n\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0
      15 \uB204\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896913
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 12\n\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0
      45 \uB204\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896914
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 8\n\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0
      15 \uB204\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896915
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 12\n\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0
      45 \uB204\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896916
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 8\n\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0
      15 \uB204\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896917
    m_Localized: "\uC8FC\uC0AC\uC704 \uD310\uC815 12\n\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0
      45 \uB204\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896918
    m_Localized: "\uB204\uC801\uD55C \uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0 \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896919
    m_Localized: "\uC9C0\uAE08\uAE4C\uC9C0 \uCC44\uAD74\uD55C \uB354\uC2A4\uD2F0\uC6C0\uC744
      \uCC59\uACA8 \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896920
    m_Localized: "\uCC44\uAD74\uD574 \uB450\uC5C8\uB358 \uB354\uC2A4\uD2F0\uC6C0\uB9C8\uC800
      \uC794\uD574 \uC18D\uC5D0 \uBB3B\uD600 \uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896921
    m_Localized: "\uBD95\uAD34\uB418\uAE30 \uC804 \uBAA8\uB4E0 \uB354\uC2A4\uD2F0\uC6C0\uC744
      \uD655\uBCF4\uD558\uB294 \uB370 \uC131\uACF5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896922
    m_Localized: "\uC0C1\uC810 \uC774\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896923
    m_Localized: "\u201C\uC774 \uC815\uB3C4\uBA74 \uB410\uACA0\uC9C0. \uC624\uB798
      \uBD99\uC7A1\uC544 \uB458 \uC0DD\uAC01\uC740 \uC5C6\uC5B4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896924
    m_Localized: "\uD30C\uD2F0 \uC804\uC6D0\uC758 \uCD5C\uB300 \uC0DD\uBA85\uB825
      12 \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896925
    m_Localized: "\uD30C\uD2F0 \uC804\uC6D0\uC758 \uCD5C\uB300 \uB9C8\uB098 2 \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896926
    m_Localized: "\uC131\uACF5 \uD655\uB960 90%\n\uC131\uACF5: \uAE30\uC5B5 1\uAC1C
      \uAC01\uC131\n\uC2E4\uD328: \uAE30\uC5B5 \uC18C\uBA78"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896927
    m_Localized: "\uC131\uACF5 \uD655\uB960 50%\n\uC131\uACF5: \uAE30\uC5B5 1\uAC1C
      \uAC01\uC131\n\uC2E4\uD328: \uAE30\uC5B5 \uC18C\uBA78"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896928
    m_Localized: "\uC131\uACF5 \uD655\uB960 30%\n\uC131\uACF5: \uAE30\uC5B5 1\uAC1C
      \uAC01\uC131\n\uC2E4\uD328: \uAE30\uC5B5 \uC18C\uBA78"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896929
    m_Localized: "\uC774\uBCA4\uD2B8 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 11981180466896930
    m_Localized: "\"\uB354 \uC774\uC0C1 \uB04C\uC5B4\uB0BC \uD798\uC740 \uB0A8\uC544
      \uC788\uC9C0 \uC54A\uC740 \uB4EF\uD558\uB2E4.\u201D"
    m_Metadata:
