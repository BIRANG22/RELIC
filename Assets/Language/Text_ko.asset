      m_Items: []
  - m_Id: 41387432259100752
    m_Localized: "\uAC15\uD654\uAC00\uB2A5\uC2A4\uD0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100753
    m_Localized: "\uAC15\uD654\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100756
    m_Localized: "\uD328\uC2DC\uBE0C\uC2A4\uD0AC\uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100757
    m_Localized: "\uAC8C\uC784\uC744 \uC885\uB8CC\uD558\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100760
    m_Localized: "\uBC30\uC591\uC870 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100761
    m_Localized: "\uC7AC\uB8CC \uD22C\uC785\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100762
    m_Localized: "\uBE44\uC5B4 \uC788\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100763
    m_Localized: "\uC870\uD569\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100775
    m_Localized: "\uC2A4\uD0AC \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 41387432259100776
    m_Localized: "\uAC00\uBC29\uC774 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4. \uC11C\uB85C
      \uB2E4\uB978 \uC544\uC774\uD15C\uC740 \uCD5C\uB300 {0}\uC885\uB958\uAE4C\uC9C0
      \uBCF4\uC720\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915657494528
    m_Localized: "\uD790\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466048
    m_Localized: "\u201C\uAC15\uD55C \uB188\uB4E4\uC774 \uB4DD\uC2E4\uAC70\uB9B0\uB2E4\uBA70?
      \uADF8\uB7FC \uB0B4\uAC00 \uAC00\uC57C\uC9C0.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466049
    m_Localized: "\uCE74\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466050
    m_Localized: "\u201C\uC784\uBB34\uB77C\uBA74 \uC644\uC218\uD55C\uB2E4. \uADF8\uBFD0\uC774\uC57C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466051
    m_Localized: "\uD5E4\uC774\uC988"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466052
    m_Localized: "\u201C\uC815\uB9D0 \uC81C\uAC00 \uAC00\uC57C \uD558\uB294 \uAC74\uAC00\uC694?\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466053
    m_Localized: "\uC774\uB124\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466054
    m_Localized: "\u201C\uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694. \uBAA8\uB450
      \uBB34\uC0AC\uD788 \uB3CC\uC544\uAC08 \uC218 \uC788\uB3C4\uB85D \uD560\uAC8C\uC694.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466055
    m_Localized: "\uB808\uC774\uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466056
    m_Localized: "\u201C\uADF8\uB0E5 \uB0B4\uAC00 \uAC00\uACE0 \uC2F6\uC5B4\uC11C
      \uAC00\uB294 \uAC70\uC57C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466057
    m_Localized: "\uBA38\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466060
