    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631996
    m_Localized: "\uCCAB \uACF5\uACA9\uC758 \uD53C\uD574\uAC00 50% \uC99D\uAC00\uD55C\uB2E4.
