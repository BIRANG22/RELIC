    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839950
    m_Localized: "\uACE0\uC720\uC790\uC6D0 \uCD08\uACFC \uCF54\uC2A4\uD2B8 \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839951
    m_Localized: "\uACE0\uC720\uC790\uC6D0 \uCD5C\uB300 \uC2A4\uD0AC \uCF54\uC2A4\uD2B8
      \uBCC0\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839952
    m_Localized: "\uBAA8\uB4E0 \uB514\uBC84\uD504\uB97C \uC81C\uAC70\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839953
    m_Localized: "\uC120\uD0DD\uD55C \uBE48 \uADF8\uB9AC\uB4DC\uB85C \uC774\uB3D9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839954
    m_Localized: "\uC120\uD0DD\uD55C \uADF8\uB9AC\uB4DC\uC758 \uC544\uAD70\uACFC
      \uC704\uCE58\uB97C \uAD50\uD658\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839955
    m_Localized: "\uB3C5 \uC7A5\uD310 \uC0DD\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839956
    m_Localized: "\uC2DC\uCCB4\uB354\uBBF8"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839957
    m_Localized: "\uC548\uC2DD\uC758 \uC0D8"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839959
    m_Localized: "\uADE0\uC5F4\uC758 \uBA54\uC544\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839960
    m_Localized: "\uC544\uB4DC\uB808\uB0A0\uB9B0"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839961
    m_Localized: "\uC774\uBC88 \uD134 \uB3D9\uC548 \uACF5\uACA9 \uAE30\uC5B5\uC758
      \uD53C\uD574\uB7C9\uC774 100% \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536462839962
    m_Localized: "\uACBD\uD654\uC81C \uC570\uD50C"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034112
    m_Localized: "\uC751\uCD95 \uC5D0\uD14C\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034113
    m_Localized: "\uCE74\uB974\uB9C8\uB97C 3 \uD68C\uBCF5\uD55C\uB2E4. \uD604\uC7AC
      \uCE74\uB974\uB9C8\uC640 \uC608\uC57D\uB41C \uCE74\uB974\uB9C8\uB97C \uD569\uD55C
      \uAC12\uC740 \uCD5C\uB300\uCE58\uB97C \uCD08\uACFC\uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034114
    m_Localized: "\uB9C8\uB098\uB97C 10 \uD68C\uBCF5\uD55C\uB2E4. \uCD5C\uB300\uCE58\uB97C
      \uCD08\uACFC\uD558\uC5EC \uBCF4\uC720\uD560 \uC218 \uC788\uC73C\uBA70, \uCD08\uACFC\uD55C
      \uB9C8\uB098\uB294 \uB2E4\uC74C \uD134\uC5D0 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034115
    m_Localized: "\uAC01\uC131\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034116
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C \uC2E0\uC18D 2\uB97C \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034117
    m_Localized: "\uB9D1\uC740 \uBB3C\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034118
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C \uBD80\uC5EC\uB41C \uBAA8\uB4E0 \uB514\uBC84\uD504\uB97C
      \uC81C\uAC70\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034119
    m_Localized: "\uC120\uD0DD\uD55C \uBE48 \uADF8\uB9AC\uB4DC\uB85C \uC774\uB3D9\uD55C\uB2E4.
      \uC774\uB3D9 \uD6C4 \uC608\uC57D\uD55C \uC774\uB3D9 \uBC0F \uACF5\uACA9 \uD589\uB3D9\uC740
      \uCDE8\uC18C\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034120
    m_Localized: "\uC120\uD0DD\uD55C \uADF8\uB9AC\uB4DC\uC758 \uC544\uAD70\uACFC
      \uC704\uCE58\uB97C \uBCC0\uACBD\uD55C\uB2E4. \uC704\uCE58\uAC00 \uBCC0\uACBD\uB41C
      \uB450 \uCE90\uB9AD\uD130\uAC00 \uC608\uC57D\uD55C \uC774\uB3D9 \uBC0F \uACF5\uACA9
      \uD589\uB3D9\uC740 \uCDE8\uC18C\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034121
    m_Localized: "\uC120\uD0DD\uD55C \uC801\uC740 \uC774\uBC88 \uD134 \uB3D9\uC548
      \uC8FC\uB294 \uD53C\uD574\uAC00 50% \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11677536467034122
    m_Localized: "\uC120\uD0DD\uD55C \uBE48 \uADF8\uB9AC\uB4DC\uC5D0 \uC794\uD574\uB97C
      \uC0DD\uC131\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11697455342559232
    m_Localized: "\uC5F0\uC131\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 11699293018136576
    m_Localized: "\uC804\uCCB4\uBCFC\uB968"
    m_Metadata:
      m_Items: []
  - m_Id: 11699293039108096
    m_Localized: "\uBC1D\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 11751459711885317
    m_Localized: "\uD574\uB2F9 \uC544\uC774\uD15C\uC758 \uD6A8\uACFC\n\uD574\uB2F9
      \uC544\uC774\uD15C\uC758 \uD6A8\uACFC\n\uD574\uB2F9 \uC544\uC774\uD15C\uC758
      \uD6A8\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 11753938784624640
    m_Localized: "\uB354\uC2A4\uD2F0\uC6C0\uC774 \uACFC\uB3C4\uD558\uAC8C \uC751\uCD95\uB418\uBA70
      \uCE68\uC2DD \uAD6C\uC5ED\uC774 \uC0DD\uACA8\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11753938788818944
    m_Localized: "\uCE68\uC2DD\uB41C \uB545\uC5D0\uB294 \uC815\uCCB4\uB97C \uC54C
      \uC218 \uC5C6\uB294 \uBCC0\uC774\uCCB4\uAC00 \uB098\uD0C0\uB0AC\uACE0,"
    m_Metadata:
      m_Items: []
  - m_Id: 11753938788818945
    m_Localized: "\uADF8\uACF3\uC740 \uC810\uCC28 \uD568\uBD80\uB85C \uBC1C\uC744
      \uB4E4\uC774\uAE30 \uC5B4\uB824\uC6B4 \uC704\uD5D8\uD55C \uC7A5\uC18C\uAC00
      \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11753938788818946
    m_Localized: "\uD559\uD68C\uB294 \uCE68\uC2DD\uC758 \uC6D0\uC778\uC744 \uD30C\uC545\uD558\uACE0
      \uD604\uC0C1\uC744 \uC5F0\uAD6C\uD558\uACE0\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 11753938788818947
    m_Localized: "\uCE68\uC2DD \uAD6C\uC5ED\uC5D0 \uB300\uD55C \uC870\uC0AC\uB97C
      \uACB0\uC815\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11753938788818948
    m_Localized: "\uC5BC\uB9C8 \uB4A4, \uD0D0\uC0AC \uC778\uC6D0\uC744 \uBAA8\uC9D1\uD558\uB294
      \uC758\uB8B0\uC11C\uAC00 \uB0B4\uAC78\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11753938788818949
    m_Localized: "\uC800\uB9C8\uB2E4 \uB2E4\uB978 \uC774\uC720\uB97C \uAC00\uC9C4
      \uC774\uB4E4\uC774 \uADF8 \uC758\uB8B0\uC11C\uB97C \uC9D1\uC5B4 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11753938788818950
    m_Localized: "\uCE68\uC2DD \uAD6C\uC5ED\uC758 \uACBD\uACC4\uC5D0\uB294 \uD0D0\uC0AC
      \uAC70\uC810\uC774 \uC138\uC6CC\uC84C\uACE0,"
    m_Metadata:
      m_Items: []
  - m_Id: 11753938788818951
    m_Localized: "\uD558\uB098\uB458 \uADF8\uACF3\uC73C\uB85C \uBAA8\uC5EC\uB4E4\uC5C8\uB2E4."
