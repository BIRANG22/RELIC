    m_Localized: "\uCE74\uB974\uB9C8\uAC00 \uCD5C\uB300\uC5D0 \uB3C4\uB2EC\uD558\uBA74
      \uB2E4\uC74C \uD134\uC5D0 \uB9C8\uB098\uB97C {ValueRate1} \uD68C\uBCF5\uD55C\uB2E4."
