      m_Items: []
  - m_Id: 21894353345060872
    m_Localized: "\uCE74\uB974\uB9C8\uAC00 \uCD5C\uB300\uCE58\uC5D0 \uB3C4\uB2EC\uD558\uBA74
      \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uCDE8\uC57D\uC744 {ValueRate1} \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944468
    m_Localized: "\uBCC0\uC774\uCCB4\uB97C \uD074\uB9AD\uD558\uC5EC \uC815\uBCF4\uB97C
      \uD30C\uC545\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944469
    m_Localized: "\uD074\uB9AD\uD558\uAC70\uB098 A\uB97C \uB20C\uB7EC \uC774\uB3D9\uC744
      \uC120\uD0DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944470
    m_Localized: "\uADF8\uB9AC\uB4DC\uB97C \uD074\uB9AD\uD558\uC5EC \uC774\uB3D9\uC744
      \uC9C4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944471
    m_Localized: "\uD074\uB9AD\uD558\uAC70\uB098 Q\uB97C \uC0AC\uC6A9\uD558\uC5EC
      \uACF5\uACA9\uC744 \uC608\uC57D\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944472
    m_Localized: "\uC608\uC57D\uD55C \uD589\uB3D9\uC740 \uD0C0\uC784\uB77C\uC778\uC5D0
      \uB4F1\uB85D\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944473
    m_Localized: "\uD134 \uC5D4\uB4DC \uBC84\uD2BC \uB610\uB294 Space\uB97C \uB20C\uB7EC
      \uC608\uC57D\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944474
    m_Localized: "\uAC19\uC740 \uACF5\uACA9\uC744 \uC5F0\uC18D\uC73C\uB85C \uC608\uC57D\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uACF5\uACA9\uC744 \uB450 \uBC88 \uC608\uC57D\uD574
      \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944475
    m_Localized: "\uAC19\uC740 \uACF5\uACA9\uC744 \uD55C \uBC88 \uB354 \uC608\uC57D\uD574
      \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22145802691944476
    m_Localized: "\uD134 \uC5D4\uB4DC \uBC84\uD2BC \uB610\uB294 Space\uB97C \uB20C\uB7EC
      \uC608\uC57D\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22221673343754240
    m_Localized: "\uD6A8\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 22221673364725761
    m_Localized: "\uB370\uBAA8 \uBC84\uC804 \uD50C\uB808\uC774 \uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\n\uD604\uC7AC
      \uBC84\uC804\uC5D0\uC11C \uAD6C\uD604\uB41C \uB0B4\uC6A9\n\n- \uB9F5 \uC0DD\uC131\n-
