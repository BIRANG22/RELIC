  - m_Id: 19388577758060611
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC(\uBE14\uB86D 1\uB9C8\uB9AC)"
    m_Metadata:
      m_Items: []
  - m_Id: 19388577758060612
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC(\uB4DC\uB77C\uC6B0\uADF8 1\uB9C8\uB9AC)"
    m_Metadata:
      m_Items: []
  - m_Id: 19388577758060613
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC(\uBA38\uD06C, \uBE14\uB77C\uC774\uD2B8)"
    m_Metadata:
      m_Items: []
  - m_Id: 19388577758060614
    m_Localized: "\uC0C8\uB85C\uC6B4 \uB3D9\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 19388577758060615
    m_Localized: "\u201C\uB098 \uD63C\uC790\uC11C\uB294 \uC880 \uBB34\uC11C\uC6B4\uB370,
      \uAC19\uC774 \uAC00\uBA74 \uC548 \uB420\uAE4C?\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 19388577758060616
    m_Localized: "\uB73B\uBC16\uC758 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 19388577758060617
    m_Localized: "\uAE38\uAC00\uC5D0\uC11C \uD734\uC2DD\uC744 \uCDE8\uD558\uACE0
      \uC788\uB294 \uB0AF\uC120 \uC774\uB97C \uBC1C\uACAC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19395600956530688
    m_Localized: "\uD6A8\uACFC\uC124\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 19395600956530689
    m_Localized: "\uD6A8\uACFC\uC124\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 19395600956530692
    m_Localized: "\uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 19395600956530693
    m_Localized: "\uCF54\uC2A4\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 19395600956530696
    m_Localized: "\uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 19697779441410048
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC \uC2A4\uD0B5"
    m_Metadata:
      m_Items: []
  - m_Id: 19697779441410049
    m_Localized: "\uB2E4\uC74C \uAD6C\uC5ED"
    m_Metadata:
      m_Items: []
  - m_Id: 19697779441410050
    m_Localized: "\uBCF5\uADC0"
    m_Metadata:
      m_Items: []
  - m_Id: 19697779441410051
    m_Localized: "\uC774\uBC88 \uB370\uBAA8\uC5D0\uC11C\uB294 \uC815\uD574\uC9C4
      \uD30C\uD2F0\uB85C \uD558\uB098\uC758 \uACBD\uB85C\uB97C \uB530\uB77C \uC9C4\uD589\uD569\uB2C8\uB2E4.\\n\uC804\uD22C\uC640
      \uC774\uBCA4\uD2B8\uB97C \uB3CC\uD30C\uD558\uBA70 \uC5EC\uC815\uC744 \uC644\uC218\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19697779441410052
    m_Localized: "\uC544\uAD70\uC758 \uD589\uB3D9\uC744 \uB4F1\uB85D\uD558\uBA74
      \uD0C0\uC784\uB77C\uC778 \uC21C\uC11C\uB300\uB85C \uC804\uD22C\uAC00 \uC9C4\uD589\uB429\uB2C8\uB2E4.\\n\uC801\uC744
      \uBAA8\uB450 \uCC98\uCE58\uD558\uBA74 \uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19697779441410053
    m_Localized: "\uCE90\uB9AD\uD130\uC640 \uC2A4\uD0AC\uC744 \uC120\uD0DD\uD574
      \uD589\uB3D9\uC744 \uB4F1\uB85D\uD558\uC138\uC694.\\n\uB4F1\uB85D\uB41C \uD589\uB3D9\uC740
      \uD0C0\uC784\uB77C\uC778\uC758 \uC67C\uCABD\uBD80\uD130 \uC21C\uC11C\uB300\uB85C
      \uC2E4\uD589\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19697779441410054
    m_Localized: "\uBAAC\uC2A4\uD130 \uB610\uB294 \uD0C0\uC784\uB77C\uC778\uC758
      \uC801 \uD589\uB3D9\uC744 \uC120\uD0DD\uD558\uC138\uC694.\\n\uC608\uC815\uB41C
      \uC2A4\uD0AC\uACFC \uACF5\uACA9 \uBC94\uC704\uB97C \uBBF8\uB9AC \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19697779441410055
    m_Localized: "\uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD558\uBA74 \uB2E4\uC74C
      \uD0D0\uD5D8\uC5D0 \uC0AC\uC6A9\uD560 \uBCF4\uC0C1\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4.\\n\uD30C\uD2F0\uB97C
      \uAC15\uD654\uD55C \uB4A4 \uB2E4\uC74C \uACBD\uB85C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19995735533035520
    m_Localized: "\uCC3D\uD654\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 19995735554007040
    m_Localized: "\uD14C\uB450\uB9AC\uC5C6\uB294\uD654\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 20392658173698048
    m_Localized: "\uCE90\uB9AD\uD130\uC640 \uAC19\uC740 \uB77C\uC778\uC744 \uB9DE\uCD94\uAE30
      \uC704\uD5741\uCE78 \uB610\uB294 2\uCE78 \uCD5C\uB300 2\uD68C \uC774\uB3D9\uD55C\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20392658173698049
    m_Localized: "\uC2A4\uD0AC\uD6A8\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 20392658173698051
    m_Localized: "\uC774\uBC88 \uD134\uC5D0 \uC0AC\uB9DD\uD55C \uBCC0\uC774\uCCB4
      \uD558\uB098\uB97C \uB2E4\uC74C \uD134 \uC2DC\uC791 \uC2DC 30%\uC758 \uC0DD\uBA85\uB825\uC73C\uB85C
      \uB418\uC0B4\uB9B0\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20392658173698052
    m_Localized: "\uBAAC\uC2A4\uD130 \uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 20392658173698053
    m_Localized: "\uD589\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 20392658173698054
    m_Localized: "\uC0C1\uD0DC"
    m_Metadata:
      m_Items: []
  - m_Id: 20540429560193024
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC \uB0B4\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 20540429581164544
    m_Localized: "\uBC29\uC5B4\uB3C4 \uBE44\uB840 \uD53C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 20540429581164545
    m_Localized: "\uC2DC\uC804\uC790\uC758 \uD604\uC7AC \uBC29\uC5B4\uB3C4\uC5D0
