    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631958
    m_Localized: "\uC801\uC758 \uACF5\uACA9 \uB300\uC0C1\uC774 \uB418\uB294 \uC18C\uD658\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631959
    m_Localized: "\uD3ED\uBC1C \uC778\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631960
    m_Localized: "5\uBC88 \uC2AC\uB86F \uD589\uB3D9\uC774 \uB05D\uB098\uBA74 \uC8FC\uBCC0
      \uC801\uC5D0\uAC8C \uACE0\uC815\uD53C\uD574\uB97C \uC8FC\uB294 \uC18C\uD658\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631961
    m_Localized: "\uAC70\uBBF8\uC54C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631962
    m_Localized: "2\uD134 \uD6C4 \uC2E0\uB354\uB85C \uBD80\uD654\uD569\uB2C8\uB2E4.
      \uD53C\uD574\uB97C \uBC1B\uC544 HP\uAC00 0\uC774 \uB418\uBA74 \uD30C\uAD34\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631963
    m_Localized: "\uAC70\uBBF8\uC904"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631964
    m_Localized: "\uC9C4\uC785\uD55C \uCE90\uB9AD\uD130\uC758 \uB2E4\uC74C \uC774\uB3D9
      \uC608\uC57D \uC0AC\uC6A9 \uCF54\uC2A4\uD2B8\uAC00 2\uBC30\uAC00 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631965
    m_Localized: "\uCD5C\uB300 HP"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631966
    m_Localized: "\uC720\uB2DB\uC758 \uC0DD\uBA85\uB825 \uC790\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631967
    m_Localized: "\uCD5C\uB300 Cost"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631968
    m_Localized: "\uC720\uB2DB\uC758 \uC2A4\uD0AC\uC0AC\uC6A9\uC5D0 \uD544\uC694\uD55C
      \uC790\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631969
    m_Localized: "\uD0C0\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631970
    m_Localized: "\uC77C\uBC18\uC801\uC778 \uD53C\uD574\uB97C \uC900\uB2E4. \uB300\uC0C1\uC758
      \uBC29\uC5B4\uB3C4\uAC00 \uC788\uC73C\uBA74 \uBC29\uC5B4\uB3C4\uBD80\uD130
      \uAC10\uC18C\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631971
    m_Localized: "\uAD00\uD1B5"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631972
    m_Localized: "\uBC29\uC5B4\uB3C4\uB97C \uBB34\uC2DC\uD558\uACE0 \uB300\uC0C1\uC758
      \uCCB4\uB825\uC5D0 \uC9C1\uC811 \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631973
    m_Localized: "\uB109\uBC31"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631974
    m_Localized: "\uB300\uC0C1\uC744 \uC2DC\uC804\uC790\uC640 \uBA40\uC5B4\uC9C0\uB294
      \uBC29\uD5A5\uC73C\uB85C \uBC00\uC5B4\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631975
    m_Localized: "\uADF8\uB7A9"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631976
    m_Localized: "\uB300\uC0C1\uC744 \uC2DC\uC804\uC790\uC640 \uAC00\uAE4C\uC6CC\uC9C0\uB294
      \uBC29\uD5A5\uC73C\uB85C \uB2F9\uACA8\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631977
    m_Localized: "\uCDA9\uB3CC"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631978
    m_Localized: "\uC774\uB3D9 \uC911 \uC720\uB2DB \uB610\uB294 \uC7A5\uC560\uBB3C\uC5D0
      \uB9C9\uD788\uBA74 2\uC758 \uACE0\uC815 \uD53C\uD574\uB97C \uBC1B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631979
    m_Localized: "\uC99D\uD3ED"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631980
    m_Localized: "\uC774\uBC88 \uD134 \uB3D9\uC548 \uACF5\uACA9 \uC218\uCE58\uAC00
      \uC218\uCE58\uB9CC\uD07C \uC99D\uAC00\uD55C\uB2E4. \uD134 \uC885\uB8CC \uC2DC
      \uC99D\uD3ED \uC218\uCE58\uB294 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631981
    m_Localized: "\uBC29\uC5B4\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631982
    m_Localized: "\uBC88 \uD134 \uB3D9\uC548 \uC218\uCE58\uB9CC\uD07C \uD53C\uD574\uB97C
      \uB9C9\uB294\uB2E4. \uD134 \uC885\uB8CC \uC2DC \uBC29\uC5B4\uB3C4 \uC218\uCE58\uB294
      \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631983
    m_Localized: "\uCE58\uC720"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631984
    m_Localized: "\uCCB4\uB825\uC744 \uC218\uCE58\uB9CC\uD07C \uC989\uC2DC \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631985
    m_Localized: "\uCF54\uC2A4\uD2B8\uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631986
    m_Localized: "\uCF54\uC2A4\uD2B8\uB97C \uC218\uCE58\uB9CC\uD07C \uC989\uC2DC
      \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631987
    m_Localized: "\uACE0\uC720\uC790\uC6D0\uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631988
    m_Localized: "\uACE0\uC720\uC790\uC6D0\uC744\uC218\uCE58\uB9CC\uD07C \uC989\uC2DC
      \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631989
    m_Localized: "\uCDA9\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631990
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uCF54\uC2A4\uD2B8\uB97C \uC218\uCE58\uB9CC\uD07C
      \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631991
    m_Localized: "\uC9D1\uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631992
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uACE0\uC720\uC790\uC6D0(\uBD84\uB178,
      \uAE30\uC138, \uC5D0\uD14C\uB974, \uC2E0\uC559, \uD608\uAE30)\uC744(\uB97C)
      \uC218\uCE58\uB9CC\uD07C \uD68D\uB4DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631993
    m_Localized: "\uC2E0\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631994
    m_Localized: "\uBAAC\uC2A4\uD130\uBCF4\uB2E4 \uBA3C\uC800 \uD589\uB3D9\uC744
      \uC9C4\uD589\uD560 \uC218 \uC788\uB2E4. \uD134 \uC885\uB8CC \uC2DC \uC218\uCE58\uAC00
      1\uC529 \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631995
    m_Localized: "\uAC15\uD0C0"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631996
    m_Localized: "\uCCAB \uACF5\uACA9\uC758 \uD53C\uD574\uAC00 50% \uC99D\uAC00\uD55C\uB2E4.
      \uD134 \uC885\uB8CC \uC2DC \uC218\uCE58\uAC00 1\uC529 \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631997
    m_Localized: "\uD761\uD608"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631998
    m_Localized: "\uC900 \uD53C\uD574\uC758 30%\uB9CC\uD07C \uCCB4\uB825\uC744 \uD68C\uBCF5\uD55C\uB2E4.
      \uD134 \uC885\uB8CC \uC2DC \uC218\uCE58\uAC00 1\uC529 \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631999
