    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466090
    m_Localized: "\uC544\uB77C\uBCA8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466129
    m_Localized: "\uC6A9\uC758 \uAC00\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915678466130
    m_Localized: "\uC6A9\uC758 \uD798\uC73C\uB85C \uC790\uC2E0\uACFC \uC544\uAD70\uC5D0\uAC8C
      \uBC29\uC5B4\uB3C4 6\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915682660423
    m_Localized: "\uD06C\uB808\uC13C\uD2B8\uC2A4\uC719+"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048991
    m_Localized: "\uC6A9\uB9B0\xB7\uBD84\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048992
    m_Localized: "\uD0D0\uC0AC \uC2DC\uC791 \uC2DC \uCE74\uB974\uB9C8\uB97C {ValueRate1}
      \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048993
    m_Localized: "\uC6A9\uB9B0\xB7\uACA9\uC559"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048994
    m_Localized: "\uCE74\uB974\uB9C8\uAC00 \uCD5C\uB300\uC5D0 \uB3C4\uB2EC\uD558\uBA74
      \uB2E4\uC74C \uD134\uC5D0 \uC99D\uD3ED\uC744 {ValueRate1} \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048995
    m_Localized: "\uC6A9\uB9B0\xB7\uC218\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048996
    m_Localized: "\uC6A9\uC758 \uAC00\uD638\uB85C \uBD80\uC5EC\uD558\uB294 \uBC29\uC5B4\uB3C4\uAC00
      {ValueRate1}\uBC30\uB85C \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048997
    m_Localized: "\uC6A9\uB9B0\xB7\uACA9\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048998
    m_Localized: "\uB300\uC9C0 \uAC00\uB974\uAE30\uC758 \uD53C\uD574\uB7C9\uC774
      {ValueRate1} \uC99D\uAC00\uD558\uACE0, \uB109\uBC31\uC774 {ValueRate2}\uCE78\uC73C\uB85C
      \uBCC0\uACBD\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691048999
    m_Localized: "\uC6A9\uB9B0\xB7\uB9F9\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691049000
    m_Localized: "\uD718\uB450\uB974\uAE30\uC640 \uB0B4\uB824\uCC0D\uAE30\uC758 \uD53C\uD574\uB7C9\uC774
      {ValueRate1} \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915691049001
    m_Localized: "\uAC80\uC2EC\xB7\uC608\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631872
    m_Localized: "\uD0D0\uC0AC \uC2DC\uC791 \uC2DC \uCE74\uB974\uB9C8\uB97C {ValueRate1}
      \uD68C\uBCF5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631873
    m_Localized: "\uAC80\uC2EC\xB7\uC808\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631874
    m_Localized: "\uCE74\uB974\uB9C8\uAC00 \uCD5C\uB300\uC5D0 \uB3C4\uB2EC\uD558\uBA74
      \uB2E4\uC74C \uD134\uC5D0 \uAC15\uD0C0\uB97C {ValueRate1} \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631875
    m_Localized: "\uAC80\uC2EC\xB7\uC5F0\uBB34"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631876
    m_Localized: "\uC9C8\uD48D\uAC80 \uC5F0\uBB34\uC758 \uACF5\uACA9 \uD69F\uC218\uAC00
      {ValueRate1}\uD68C \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631877
    m_Localized: "\uAC80\uC2EC\xB7\uC77C\uC12C"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631878
    m_Localized: "\uC9C8\uD48D\uAC80 \uC77C\uC12C\uC758 \uD53C\uD574\uB7C9\uC774
      {ValueRate1} \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631879
    m_Localized: "\uAC80\uC2EC\xB7\uC9C8\uD48D"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631880
    m_Localized: "\uC9C8\uD48D\uAC80 3\uC2DD\uACFC \uC9C8\uD48D\uAC80 1\uC2DD\uC758
      \uD53C\uD574\uB7C9\uC774 {ValueRate1} \uC99D\uAC00\uD55C\uB2E4."
