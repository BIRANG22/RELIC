  - m_Id: 10185974310510782
    m_Localized: "\uADE0\uC5F4\uC758 \uBA54\uC544\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510783
    m_Localized: "\uD5C8\uACF5\uC5D0 \uAC08\uB77C\uC9C4 \uADE0\uC5F4\uC774 \uBAA8\uC2B5\uC744
      \uB4DC\uB7EC\uB0C8\uB2E4. \uD2C8 \uC0AC\uC774\uB85C \uC0C8\uC5B4 \uB098\uC628
      \uBE5B \uC18D\uC5D0\uC11C \uD76C\uBBF8\uD55C \uAE30\uC5B5\uC758 \uD754\uC801\uC774
