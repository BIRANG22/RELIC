    m_Metadata:
      m_Items: []
  - m_Id: 41385915707826192
    m_Localized: "\uC9C1\uC811 \uACF5\uACA9\uC744 \uBC1B\uC744 \uB54C\uB9C8\uB2E4
      \uC218\uCE58\uAC00 1 \uAC10\uC18C\uD55C\uB2E4. \uC218\uCE58\uAC00 0\uC774 \uB418\uBA74
