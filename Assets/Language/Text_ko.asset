      m_Items: []
  - m_Id: 41385915737186373
    m_Localized: B
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186374
    m_Localized: "\uBCA0\uC2A4\uD30C\uC758 \uB3C5\uC774 \uC2A4\uBA70\uB4E0 \uCE68\uC774\uB2E4.
      \uD310\uB9E4 \uC2DC 24 \uB354\uC2A4\uD2F0\uC6C0\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
