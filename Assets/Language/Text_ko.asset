      m_Items: []
  - m_Id: 41385915703631886
    m_Localized: "\uB0A0\uCE74\uB85C\uC6B4 \uBE5B\uC758 \uD53C\uD574\uB7C9\uC774
      {ValueRate1} \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915703631887
    m_Localized: "\uBD88\uC528\xB7\uC758\uC9C0"
    m_Metadata:
      m_Items: []
