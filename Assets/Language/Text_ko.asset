    m_Localized: "\uCE68\uC2DD\uB3C4 20 \uC99D\uAC00\n\uBB34\uC791\uC704 \uC77C\uBC18~\uC720\uB2C8\uD06C
      \uC720\uBB3C \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6579587282193344706
    m_Localized: "\uC804\uCCB4 \uC0DD\uBA85\uB825 15 \uD68C\uBCF5\n\uD5E4\uC774\uC988
      \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 4035915082772380139
    m_Localized: "\uC9C0\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 3444185439531223621
    m_Localized: "\uC0DD\uBA85\uB825 \uD68C\uBCF5\uB7C9 +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8802548698092418766
    m_Localized: "\uCD5C\uB300 \uC0DD\uBA85\uB825 \uC99D\uAC00\uB7C9 +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7976493799859799195
    m_Localized: "\uD30C\uD2F0 \uC804\uC6D0 \uCD5C\uB300 \uC0DD\uBA85\uB825 {0:+#;-#;0}
      \uC801\uC6A9 ({1}\uBA85)"
    m_Metadata:
      m_Items: []
  - m_Id: 233547581394359481
    m_Localized: "\uD30C\uD2F0 \uB9C8\uB098 \uD68C\uBCF5\uB7C9 {0:+#;-#;0} \uC801\uC6A9
      ({1}\uBA85)"
    m_Metadata:
      m_Items: []
  - m_Id: 533658993916296967
    m_Localized: "\uD30C\uD2F0 \uCD5C\uB300 \uB9C8\uB098 {0:+#;-#;0} \uC801\uC6A9
      ({1}\uBA85)"
    m_Metadata:
      m_Items: []
  - m_Id: 5528466554244437462
    m_Localized: "\uD30C\uD2F0 \uC804\uC6D0 \uC0DD\uBA85\uB825 {0} \uD68C\uBCF5 ({1}\uBA85)"
    m_Metadata:
      m_Items: []
  - m_Id: 7305291514702919854
    m_Localized: "\uD30C\uD2F0 \uC804\uC6D0 \uCD5C\uB300 \uC0DD\uBA85\uB825 {0} \uC99D\uAC00
      ({1}\uBA85)"
    m_Metadata:
      m_Items: []
  - m_Id: 8323492462400198106
    m_Localized: "\uC120\uD0DD\uD55C \uAE30\uC5B5\uC744 \uAC15\uD654\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6629449557644834442
    m_Localized: "\uAE30\uC5B5 \uAC15\uD654: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3886573687687508414
    m_Localized: "\uC774\uBC88 \uC774\uBCA4\uD2B8\uB85C \uC5BB\uC740 \uAE30\uC5B5
      \uC81C\uAC70 \uCC98\uB9AC\uAC00 \uC900\uBE44\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 457451403533020556
    m_Localized: "\uD68D\uB4DD \uAC00\uB2A5\uD55C \uAE30\uC5B5\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2468046161523270805
    m_Localized: "\uAE30\uC874 \uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0 \uC720\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 8528883566776235055
    m_Localized: "\uB808\uB4DC \uB354\uC2A4\uD2F0\uC6C0 {0} \uB204\uC801 (\uD604\uC7AC
      {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 8026747471757970304
    m_Localized: "{0}\uC774(\uAC00) \uBD80\uC871\uD569\uB2C8\uB2E4. \uD544\uC694:
      {1} / \uBCF4\uC720: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 29406660426702848
    m_Localized: "\uBBF8\uBC1C\uACAC"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140226834432
    m_Localized: "\"\uD2C8 \uC0AC\uC774\uB85C \uC0C8\uC5B4 \uB098\uC628 \uBE5B \uC18D\uC5D0\uC11C
      \uD76C\uBBF8\uD55C \uAE30\uC5B5\uC758 \uD754\uC801\uC774 \uB290\uAEF4\uC9C4\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777472
    m_Localized: "\u201C\uBE5B\uC774 \uC11C\uC11C\uD788 \uC0AC\uADF8\uB77C\uB4E4\uACE0,
      \uD558\uB298\uC5D0 \uC5F4\uB9B0 \uADE0\uC5F4\uC740 \uB2E4\uC2DC \uACE0\uC694\uD574\uC84C\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777473
    m_Localized: "\u201C\uCC3E\uB294 \uBB3C\uAC74\uC774\uB77C\uB3C4 \uC788\uB098?
      \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uAC8C \uC788\uB2E4\uBA74 \uACE8\uB77C\uBCF4\uAC8C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777474
    m_Localized: "\"\uB2E4\uC74C\uC5D0\uB3C4 \uD544\uC694\uD55C \uBB3C\uAC74\uC774
      \uC788\uB2E4\uBA74 \uCC3E\uC544\uC624\uC2DC\uAC8C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777475
    m_Localized: "\"\uB2E4\uC74C\uC5D0 \uB610 \uB4E4\uB974\uC2DC\uAC8C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777476
    m_Localized: "\"\uBB50, \uC5B5\uC9C0\uB85C \uAD8C\uD560 \uC0DD\uAC01\uC740 \uC5C6\uB124.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777477
    m_Localized: "\u201C\uC774\uACF3\uC740 \uC624\uB798 \uBA38\uBB3C \uACF3\uC774
      \uC544\uB2D9\uB2C8\uB2E4. \uB5A0\uB098\uAE30 \uC804\uC5D0 \uC800\uD76C\uC758
      \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB9D0\uC500\uD574 \uC8FC\uC138\uC694.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777478
    m_Localized: "\u201C\uC870\uAE08\uC774\uB098\uB9C8 \uB3C4\uC6C0\uC774 \uB418\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777479
    m_Localized: "\u201C\uCE68\uC2DD\uC758 \uAE30\uC6B4\uC744 \uC870\uAE08\uC774\uB098\uB9C8
      \uC815\uD654\uD574 \uB4DC\uB838\uC2B5\uB2C8\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777480
    m_Localized: "\u201C\uB2F9\uC2E0\uB4E4\uC758 \uC0DD\uBA85\uC5D0 \uCD95\uBCF5\uC774
      \uBA38\uBB3C\uAE30\uB97C.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777481
    m_Localized: "\u201C\uC624\uB798\uB41C \uC758\uC2DD\uC758 \uD754\uC801\uC774
      \uB0A8\uC544 \uC788\uB2E4. \uC81C\uBB3C\uC744 \uBC14\uCE58\uBA74 \uC758\uC2DD\uC774
      \uB2E4\uC2DC \uC2DC\uC791\uB420 \uAC83 \uAC19\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777482
    m_Localized: "\"\uD76C\uBBF8\uD558\uAC8C \uBE5B\uB098\uB358 \uD754\uC801\uB4E4\uC774
      \uC11C\uC11C\uD788 \uC0AC\uB77C\uC84C\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777483
    m_Localized: "\"\uC694\uB3D9\uCE58\uB358 \uAE30\uC6B4\uC774 \uC11C\uC11C\uD788
      \uC7A0\uC7A0\uD574\uC84C\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777484
    m_Localized: "\"\uC190\uB300\uC9C0 \uC54A\uC740 \uCC44, \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777485
    m_Localized: "\u201C\uAE38\uAC00\uC5D0 \uBC84\uB824\uC9C4 \uB9C8\uCC28 \uD55C
      \uB300\uAC00 \uB193\uC5EC \uC788\uB2E4. \uC544\uC9C1 \uC4F8 \uB9CC\uD55C \uBB3C\uAC74\uC774
      \uB0A8\uC544 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777486
    m_Localized: "\u201C\uB354 \uC774\uC0C1 \uB208\uC5D0 \uB744\uB294 \uBB3C\uAC74\uC740
      \uC5C6\uC5B4 \uBCF4\uC778\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777487
    m_Localized: "\u201C\uB9C8\uCC28 \uC548\uC5D0\uB294 \uC774\uC81C \uC4F8 \uB9CC\uD55C
      \uBB3C\uAC74\uC774 \uB0A8\uC544 \uC788\uC9C0 \uC54A\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777488
    m_Localized: "\u201C\uB9C8\uCC28\uC5D0\uB294 \uB354 \uC774\uC0C1 \uAC00\uC838\uAC08
      \uB9CC\uD55C \uAC83\uC774 \uB0A8\uC544 \uC788\uC9C0 \uC54A\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777489
    m_Localized: "\"\uC4F8 \uB9CC\uD55C \uBB3C\uAC74\uC740 \uBC1C\uACAC\uD558\uC9C0
      \uBABB\uD588\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777490
    m_Localized: "\u201C\uBC84\uB824\uC9C4 \uC0C1\uC790\uB4E4\uC774 \uB208\uC5D0
      \uB748\uB2E4. \uC4F8 \uB9CC\uD55C \uBB3C\uAC74\uC774 \uB0A8\uC544 \uC788\uC744\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777491
    m_Localized: "\u201C\uC544\uC9C1 \uC0B4\uD3B4\uBCFC \uB9CC\uD55C \uAC83\uC774
      \uB0A8\uC544 \uC788\uB2E4. \uC870\uAE08 \uB354 \uC2DC\uB3C4\uD574 \uBCFC \uC218
      \uC788\uC744 \uAC83 \uAC19\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777492
    m_Localized: "\u201C\uB0A8\uC740 \uC0C1\uC790\uC5D0\uC11C\uB3C4 \uBB34\uC5B8\uAC00
      \uC5BB\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777493
    m_Localized: "\u201C\uB354 \uC774\uC0C1 \uAC00\uC838\uAC08 \uB9CC\uD55C \uAC83\uC740
      \uB0A8\uC544 \uC788\uC9C0 \uC54A\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777494
    m_Localized: "\u201C\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uD3ED\uBC1C\uC774 \uC77C\uC5B4\uB098\uACE0,
      \uC8FC\uBCC0\uC5D0\uB294 \uBD80\uC11C\uC9C4 \uC794\uD574\uB9CC \uB0A8\uC558\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777495
    m_Localized: "\u201C\uC0C1\uC790\uC5D0\uB294 \uC190\uB300\uC9C0 \uC54A\uACE0
      \uADF8\uB300\uB85C \uC9C0\uB098\uCCE4\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777496
    m_Localized: "\u201C\uB0A8\uC740 \uC0C1\uC790\uB294 \uADF8\uB300\uB85C \uB450\uACE0
      \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777497
    m_Localized: "\u201C\uAC70\uB300\uD55C \uAD11\uB9E5\uC774 \uD76C\uBBF8\uD55C
      \uBE5B\uC744 \uB0B4\uBFDC\uACE0 \uC788\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777498
    m_Localized: "\u201C\uAD11\uB9E5 \uAE4A\uC219\uD55C \uACF3\uC5D0\uC11C \uBE5B\uC774
      \uACC4\uC18D\uD574\uC11C \uC0C8\uC5B4 \uB098\uC628\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777499
    m_Localized: "\u201C\uAD11\uB9E5 \uACF3\uACF3\uC5D0 \uADE0\uC5F4\uC774 \uC0DD\uACBC\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777500
    m_Localized: "\u201C\uAD11\uB9E5\uC740 \uBE5B\uC744 \uC783\uACE0 \uACE0\uC694\uD574\uC84C\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140268777501
    m_Localized: "\u201C\uAD11\uB9E5\uC774 \uC21C\uC2DD\uAC04\uC5D0 \uBC14\uC2A4\uB77C\uC9C0\uBA70
      \uD754\uC801\uB3C4 \uC5C6\uC774 \uC0AC\uB77C\uC84C\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971776
    m_Localized: "\u201C\uAD11\uB9E5\uC744 \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0
      \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971777
    m_Localized: "\u201C\uC624\uB798\uB41C \uBE44\uC11D\uC5D0 \uB0AF\uC120 \uAC01\uC778\uC774
      \uC0C8\uACA8\uC838 \uC788\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971778
    m_Localized: "\u201C\uAC01\uC778\uC774 \uBE5B\uC744 \uBC1C\uD558\uBA70 \uC54C
      \uC218 \uC5C6\uB294 \uD798\uC774 \uC804\uD574\uC838 \uC628\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971779
    m_Localized: "\u201C\uAC01\uC778\uC758 \uBE5B\uC774 \uC0AC\uADF8\uB77C\uB4E4\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971780
    m_Localized: "\"\uB9D1\uC740 \uBB3C\uC774 \uACE0\uC778 \uC791\uC740 \uBD84\uC218\uC5D0\uC11C
      \uC740\uC740\uD55C \uBE5B\uC774 \uD758\uB7EC\uB098\uC628\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971781
    m_Localized: "\"\uBB3C\uACB0\uC774 \uC794\uC794\uD558\uAC8C \uAC00\uB77C\uC549\uC558\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971782
    m_Localized: "\"\uAC10\uC2F8\uB358 \uBE5B\uC774 \uC11C\uC11C\uD788 \uC0AC\uADF8\uB77C\uB4E4\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971783
    m_Localized: "\"\uB9D1\uC740 \uBE5B\uC774 \uD37C\uC838 \uB098\uAC04 \uB4A4 \uACE0\uC694\uD574\uC84C\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971784
    m_Localized: "\"\uC758\uBB38\uC758 \uC874\uC7AC\uAC00 \uAE30\uBB18\uD55C \uAC70\uB798\uB97C
      \uC81C\uC548\uD55C\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971785
    m_Localized: "\"\uB300\uAC00\uC5D0 \uB9CC\uC871\uD55C \uB4EF \uD76C\uBBF8\uD55C
      \uBBF8\uC18C\uB97C \uC9C0\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971786
    m_Localized: "\"\uC81C\uBC95 \uC6B4\uC774 \uC88B\uB2E4\uB294 \uB4EF \uD765\uBBF8\uB85C\uC6B4
      \uD45C\uC815\uC744 \uC9C0\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971787
    m_Localized: "\"\uC608\uC0C1\uD588\uB2E4\uB294 \uB4EF \uAC00\uBCCD\uAC8C \uBE44\uC6C3\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971788
    m_Localized: "\"\uCE68\uC2DD\uC758 \uAE30\uC6B4\uC744 \uBC14\uB77C\uBCF4\uBA70
      \uB9CC\uC871\uC2A4\uB7FD\uAC8C \uC6C3\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971789
    m_Localized: "\"\uAC70\uC810\uC73C\uB85C \uD5A5\uD558\uB294 \uAE38\uBAA9, \uD55C
      \uD0D0\uC0AC\uC790\uAC00 \uD734\uC2DD\uD558\uACE0 \uC788\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29391140272971790
    m_Localized: "\"\uC7A0\uC2DC \uD734\uC2DD\uC744 \uCDE8\uD55C \uC77C\uD589\uC740
      \uAE30\uC6B4\uC744 \uB418\uCC3E\uC558\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 29397909925765120
    m_Localized: "\uAC70\uC810 \uC778\uADFC"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909976096768
    m_Localized: "\uD6C4\uC544! \uC0DD\uAC01\uBCF4\uB2E4 \uBA3C \uAE38\uC778\uB370?
      \uC2AC\uC2AC \uBAB8\uC774 \uBB34\uAC70\uC6CC\uC9C0\uB294\uAC78."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909976096769
    m_Localized: "\uC544\uBB34 \uACF3\uC774\uB098 \uD074\uB9AD\uD558\uC5EC \uACC4\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909976096770
    m_Localized: "\uC774\uB7EC\uB2E4 \uAC70\uC810\uC5D0 \uB3C4\uCC29\uD558\uAE30\uB3C4
      \uC804\uC5D0 \uC9C0\uCE58\uACA0\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291072
    m_Localized: "\uBD88\uD544\uC694\uD55C \uCCB4\uB825 \uC18C\uBAA8\uB294 \uD53C\uD558\uC2DC\uC8E0.
      \uAC70\uC810\uAE4C\uC9C0 \uC5BC\uB9C8 \uB0A8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291073
    m_Localized: "\uD0D0\uC0AC \uC911\uC5D0\uB294 \uCE68\uC2DD\uB3C4\uAC00 \uB204\uC801\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291074
    m_Localized: "\uCE68\uC2DD\uB3C4\uB294 \uC0C8\uB85C\uC6B4 \uBC29\uC5D0 \uC9C4\uC785\uD558\uBA74
      3,\n\uD134\uC774 \uC9C4\uD589\uB418\uAC70\uB098 \uD53C\uD574\uB97C \uBC1B\uC744
      \uB54C\uB9C8\uB2E4 1,\n\uC804\uD22C\uBD88\uB2A5\uC774 \uB418\uBA74 10 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291075
    m_Localized: "\uCE68\uC2DD\uB3C4\uAC00 \uCD5C\uB300\uCE58\uC778 100\uC5D0 \uB3C4\uB2EC\uD558\uBA74\n\uB9E4
      \uD134 \uC0DD\uBA85\uB825\uC774 10\uC529 \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291076
    m_Localized: "\uBCC0\uC774\uCCB4\uAD70\uC694. \uC544\uBB34\uB798\uB3C4 \uADF8\uB0E5
      \uC9C0\uB098\uAC00\uAE34 \uC5B4\uB835\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291077
    m_Localized: "\uADF8\uB7FC \uB140\uC11D\uBD80\uD130 \uCC98\uB9AC\uD558\uACE0
      \uAC00\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291078
    m_Localized: "\uCE90\uB9AD\uD130 \uC0C1\uD0DC\uCC3D\uC5D0\uC11C\uB294 \uC0DD\uBA85\uB825\uACFC
      \uB9C8\uB098, \uCE74\uB974\uB9C8\uB97C \uBE44\uB86F\uD55C \uB2E4\uC591\uD55C
      \uC804\uD22C \uC815\uBCF4\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291079
    m_Localized: "\uB9C8\uB098\uC640 \uCE74\uB974\uB9C8\uB294 \uD589\uB3D9\uC5D0
      \uD544\uC694\uD55C \uC790\uC6D0\uC785\uB2C8\uB2E4.\n\uB9C8\uB098\uB294 \uC7AC\uC0DD\uB7C9\uC5D0
      \uB530\uB77C, \uCE74\uB974\uB9C8\uB294 \uB9E4 \uD134 1\uC529 \uD68C\uBCF5\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291080
    m_Localized: "\uCE90\uB9AD\uD130\uAC00 \uC7A5\uCC29\uD55C \uC720\uBB3C\uACFC
      \uB8EC\uC758 \uC815\uBCF4\uB3C4 \uAC01 \uC2AC\uB86F\uC5D0\uC11C \uC0B4\uD3B4\uBCFC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291081
    m_Localized: "\uD604\uC7AC \uCE90\uB9AD\uD130\uC5D0\uAC8C \uC801\uC6A9\uB41C
      \uBC84\uD504\uC640 \uB514\uBC84\uD504\uB3C4 \uC0C1\uD0DC\uCC3D\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291082
    m_Localized: "\uC88B\uC544! \uB140\uC11D\uC774 \uC6C0\uC9C1\uC774\uAE30 \uC804\uC5D0
      \uBA3C\uC800 \uCC98\uB9AC\uD574 \uBC84\uB9B4\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291083
    m_Localized: "\uBB34\uC791\uC815 \uB2EC\uB824\uB4E4\uAE30\uBCF4\uB2E4\uB294 \uC2E0\uC911\uD558\uAC8C
      \uC6C0\uC9C1\uC774\uB294 \uD3B8\uC774 \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291084
    m_Localized: "\uC77C\uB2E8 \uB140\uC11D\uC5D0\uAC8C \uC811\uADFC\uD574\uC11C
      \uC81C\uB300\uB85C \uD55C \uBC29 \uBA39\uC5EC\uC8FC\uACA0\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291085
    m_Localized: "\uD558\uC544\u2026 \uC5B4\uCA54 \uC218 \uC5C6\uAD70\uC694. \uB4A4\uB294
      \uC81C\uAC00 \uB9C8\uBB34\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291086
    m_Localized: "\uD0C0\uC784\uB77C\uC778\uC740 \uCD1D 5\uAC1C\uC758 \uC2AC\uB86F\uC73C\uB85C
      \uAD6C\uC131\uB418\uBA70, \uAC01 \uC2AC\uB86F\uC740 5\uCE78\uC73C\uB85C \uC774\uB8E8\uC5B4\uC838
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291087
    m_Localized: "\uBCC0\uC774\uCCB4\uAC00 \uBA3C\uC800 \uD589\uB3D9\uC744 \uC608\uC57D\uD558\uBA70,
      \uD558\uB098\uC758 \uC2AC\uB86F\uC5D0\uB294 \uC11C\uB85C \uB2E4\uB978 \uCE90\uB9AD\uD130\uC758
      \uD589\uB3D9\uC744 \uB4F1\uB85D\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291088
    m_Localized: "\uD589\uB3D9\uC5D0 \uB530\uB77C 1\uCE78\uC5D0\uC11C 3\uCE78\uC744
      \uC0AC\uC6A9\uD558\uBA70, \uD134\uC744 \uC885\uB8CC\uD558\uBA74 \uCCAB \uBC88\uC9F8
      \uC2AC\uB86F\uBD80\uD130 \uC21C\uC11C\uB300\uB85C \uC2E4\uD589\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291089
    m_Localized: "\uC774\uC678\uC5D0\uB3C4 \uD53C\uD574\uB97C \uC8FC\uAC70\uB098
      \uBC84\uD504, \uB514\uBC84\uD504 \uB4F1\uC758 \uD6A8\uACFC\uB97C \uAC00\uC9C4
      \uD589\uB3D9\uC778 '\uAE30\uC5B5'\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291090
    m_Localized: "\uC774\uB3D9\uC740 1\uCE78\uC744 \uC0AC\uC6A9\uD558\uB294 \uD589\uB3D9\uC73C\uB85C,
      \uC608\uC57D\uD55C \uAC70\uB9AC\uC5D0 \uB530\uB77C \uB9C8\uB098\uB97C \uC18C\uBAA8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291091
    m_Localized: "A \uB610\uB294 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uC5EC \uACC4\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291092
    m_Localized: "\uC774\uB3D9\uD560 \uC704\uCE58\uB97C \uC120\uD0DD\uD558\uBA74
      \uD574\uB2F9 \uD589\uB3D9\uC774 \uD0C0\uC784\uB77C\uC778\uC5D0 \uC608\uC57D\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291093
    m_Localized: "\uC774\uB3D9\uD560 \uC704\uCE58\uB97C \uD074\uB9AD\uD558\uC5EC
      \uACC4\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291094
    m_Localized: "\uAE30\uC5B5\uC758 \uBC94\uC704\uB294 \uCE90\uB9AD\uD130\uAC00
      \uBC14\uB77C\uBCF4\uB294 \uBC29\uD5A5\uC744 \uAE30\uC900\uC73C\uB85C \uC790\uB3D9
      \uC124\uC815\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291095
    m_Localized: "Q \uB610\uB294 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uC5EC \uACC4\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291096
    m_Localized: "\uCE90\uB9AD\uD130\uB97C \uBCC0\uACBD\uD558\uBA74 \uC608\uC57D\uD560
      \uC2AC\uB86F\uB3C4 \uC790\uB3D9\uC73C\uB85C \uBCC0\uACBD\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291097
    m_Localized: "Tab \uB610\uB294 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uC5EC \uACC4\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291098
    m_Localized: "\uAC19\uC740 \uAE30\uC5B5\uC744 \uC5EC\uB7EC \uBC88 \uB4F1\uB85D\uD560
      \uC218\uB3C4 \uC788\uC73C\uBA70, \uAC01\uAC01\uC758 \uD589\uB3D9\uC774 \uD0C0\uC784\uB77C\uC778\uC5D0
      \uC608\uC57D\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291099
    m_Localized: "Q \uB610\uB294 \uBC84\uD2BC\uC744 \uB450 \uBC88 \uD074\uB9AD\uD558\uC5EC
      \uACC4\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291100
    m_Localized: "\uD589\uB3D9 \uC608\uC57D\uC744 \uB9C8\uCCE4\uB2E4\uBA74 \uD134\uC744
      \uC885\uB8CC\uD569\uB2C8\uB2E4. \uADF8\uB7EC\uBA74 \uB4F1\uB85D\uD55C \uD589\uB3D9\uC774
      \uC21C\uC11C\uB300\uB85C \uC2E4\uD589\uB418\uBA70 \uC804\uD22C\uAC00 \uC9C4\uD589\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29397909980291101
    m_Localized: "Space \uB610\uB294 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uC5EC
      \uACC4\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361455374336
    m_Localized: "\uD0C0\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361501511680
    m_Localized: "\uD6A8\uACFC\uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361501511681
    m_Localized: "\uD6A8\uACFC\uC124\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361501511682
    m_Localized: "\uD6A8\uACFC\uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705984
    m_Localized: "\uC81C 1\uC9C0\uC810 - \uC794\uD574\uC758 \uBB38\uD131"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705985
    m_Localized: "\uD6A8\uACFC\uC124\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705986
    m_Localized: "\uD6A8\uACFC\uC124\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705987
    m_Localized: "\uD6A8\uACFC\uC124\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705988
    m_Localized: "\uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705989
    m_Localized: "\uCF54\uC2A4\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705990
    m_Localized: "\uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705991
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC \uC2A4\uD0B5"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705992
    m_Localized: "\uB2E4\uC74C \uAD6C\uC5ED"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705993
    m_Localized: "\uBCF5\uADC0"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705994
    m_Localized: "\uCC3D\uD654\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705995
    m_Localized: "\uD14C\uB450\uB9AC\uC5C6\uB294\uD654\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705996
    m_Localized: "\uCE90\uB9AD\uD130\uC640 \uAC19\uC740 \uB77C\uC778\uC744 \uB9DE\uCD94\uAE30
      \uC704\uD574 1\uCE78 \uB610\uB294 2\uCE78 \uCD5C\uB300 2\uD68C \uC774\uB3D9\uD55C\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705997
    m_Localized: "\uC2A4\uD0AC\uD6A8\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705998
    m_Localized: "\uC774\uBC88 \uD134\uC5D0 \uC0AC\uB9DD\uD55C \uBCC0\uC774\uCCB4
      \uD558\uB098\uB97C \uB2E4\uC74C \uD134 \uC2DC\uC791 \uC2DC 30%\uC758 \uC0DD\uBA85\uB825\uC73C\uB85C
      \uB418\uC0B4\uB9B0\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505705999
    m_Localized: "\uBAAC\uC2A4\uD130 \uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505706000
    m_Localized: "\uD589\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505706001
    m_Localized: "\uC0C1\uD0DC"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505706002
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC \uB0B4\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505706003
    m_Localized: "\uC544\uC774\uD15C\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505706004
    m_Localized: "\uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505706005
    m_Localized: "\uC7A5\uCC29\uD560 \uC6A9\uBCD1\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 29429361505706006
    m_Localized: "- \uC120\uD0DD -"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361509900288
    m_Localized: "\uBC1C\uD604\uC2DC\uD0AC \uAE30\uC5B5\uC744 1\uAC1C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 29429361509900289
    m_Localized: "\uC2A4\uD0AC\uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361509900290
    m_Localized: "\uC55E\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC744 \uC815\uB3C4\uB85C
      \uC9D9\uC740 \uC548\uAC1C\uAC00 \uC0AC\uBC29\uC744 \uB4A4\uB36E\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29429361514094592
    m_Localized: "\uC544\uB77C\uBCA8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361514094593
