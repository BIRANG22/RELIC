    m_Localized: "\uC138\uB77C\uD53C\uC544\uC758 \uC9C0\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510730
    m_Localized: "\uAE08\uB2E8\uC758 \uC758\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510731
    m_Localized: "\uB0A1\uC740 \uC0C1\uC790\uC640 \uC815\uCCB4\uB97C \uC54C \uC218
      \uC5C6\uB294 \uC758\uC2DD \uB3C4\uAD6C\uB4E4\uC774 \uC5B4\uC9C0\uB7FD\uAC8C
      \uB193\uC5EC \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510732
    m_Localized: "\uAE08\uB2E8\uC758 \uC758\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510733
    m_Localized: "\uD55C \uBC88 \uB354 \uC190\uC744 \uBED7\uC744 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
