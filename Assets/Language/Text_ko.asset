  - m_Id: 10185974310510765
    m_Localized: "\uB354\uC2A4\uD2F0\uC6C0 \uAD11\uB9E5"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510766
    m_Localized: "\uADF8\uB9BC\uC790 \uC0C1\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510767
    m_Localized: "\u201C\uC774\uB7F0 \uACF3\uC5D0\uC11C \uC190\uB2D8\uC744 \uB9CC\uB0A0
      \uC904\uC774\uC57C. \uB9C8\uCE68 \uAD1C\uCC2E\uC740 \uBB3C\uAC74\uC774 \uC880
      \uC788\uC9C0. \uAD6C\uACBD\uD574 \uBCF4\uACA0\uB098?\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510768
    m_Localized: "\uADF8\uB9BC\uC790 \uC0C1\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510769
    m_Localized: "\uC548\uC2DD\uC758 \uC0D8"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510770
    m_Localized: "\uACE0\uC694\uD55C \uBB3C\uC18C\uB9AC\uC640 \uD568\uAED8 \uBD84\uC218\uC5D0\uC11C
      \uD76C\uBBF8\uD55C \uBE5B\uC774 \uD758\uB7EC\uB098\uC628\uB2E4. \uBD84\uC218\uC5D0
      \uB0A8\uC740 \uD798\uC740 \uD55C \uBC88\uB9CC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510771
    m_Localized: "\uACF5\uBA85\uC758 \uBE44\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510772
    m_Localized: "\u201C\uBE44\uC11D\uC5D0 \uC0C8\uACA8\uC9C4 \uBB38\uC790\uAC00
      \uAE30\uC5B5\uC5D0 \uBC18\uC751\uD574 \uD76C\uBBF8\uD558\uAC8C \uBE5B\uB09C\uB2E4.
      \uC7A0\uB4E0 \uAE30\uC5B5\uC758 \uD798\uC744 \uAE68\uC6B8 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510774
    m_Localized: "\uACF5\uBA85\uC758 \uBE44\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 10185974310510775
    m_Localized: "\u201C\uC544\uC9C1 \uB0A8\uC544 \uC788\uB294 \uD798\uC744 \uD55C\uCE35
      \uB354 \uB04C\uC5B4\uB0BC \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4.\u201D"
    m_Metadata:
