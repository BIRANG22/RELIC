    m_Localized: "\uB9D0\uB791\uD55C \uBE14\uB85D\uC758 \uC810\uC561\uC774\uB2E4.
      \uD310\uB9E4 \uC2DC 7 \uB354\uC2A4\uD2F0\uC6C0\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186366
    m_Localized: "\uB79C\uC11C\uC758 \uCF54\uC5B4"
