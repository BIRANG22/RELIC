    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361522483201
    m_Localized: "\uB370\uBAA8 \uBC84\uC804\uC758 \uC5EC\uC815\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4.\n\n\uC544\uC9C1
      \uB05D\uB098\uC9C0 \uC54A\uC740 \uC774\uC57C\uAE30\uAC00 \uC5EC\uB7EC\uBD84\uC744
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uC815\uC2DD \uBC84\uC804\uC5D0\uC11C
      \uACC4\uC18D\uB420 \uC5EC\uC815\uC744 \uAE30\uB300\uD574 \uC8FC\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361522483202
    m_Localized: "\uCE68\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 29429361522483203
    m_Localized: "\uC0DD\uBA85\uB825\uC744 30% \uD68C\uBCF5\uD558\uACE0 \uCE68\uC2DD\uB3C4\uAC00
      10 \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29429361522483204
    m_Localized: "\uBB34\uC791\uC704 \uAE30\uC5B5 \uC911 \uBC1C\uD604\uD560 \uAE30\uC5B5\uC744
      1\uAC1C \uC120\uD0DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29429361522483205
    m_Localized: "\uC7A0\uC2DC \uC228\uC744 \uACE0\uB974\uBA70 \uBAB8\uACFC \uB9C8\uC74C\uC758
      \uC548\uC815\uC744 \uB418\uCC3E\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29429361522483206
    m_Localized: "\uACE0\uC694\uD55C \uBA85\uC0C1 \uC18D\uC5D0\uC11C \uD55C\uC21C\uAC04
