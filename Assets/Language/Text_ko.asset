    m_Localized: "\uBE14\uB77C\uC774\uD2B8\uC758 \uCF54\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186370
    m_Localized: A
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186371
    m_Localized: "\uBE14\uB77C\uC774\uD2B8\uC758 \uAE30\uC6B4\uC774 \uB0A8\uC544
      \uC788\uB294 \uCF54\uC5B4\uB2E4. \uD310\uB9E4 \uC2DC 10 \uB354\uC2A4\uD2F0\uC6C0\uC744
      \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41385915737186372
    m_Localized: "\uBCA0\uC2A4\uD30C\uC758 \uB3C5\uCE68"
