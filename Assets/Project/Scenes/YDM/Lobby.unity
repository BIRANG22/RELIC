  runeNotEquippedMessage: "\uC7A5\uCC29 \uC911\uC778 \uB8EC\uC774 \uC544\uB2D9\uB2C8\uB2E4."
  runeSlotNotConnectedMessage: "\uB8EC \uC2AC\uB86F\uC774 \uC5F0\uACB0\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  runeSlotLockedMessage: "\uC544\uC9C1 \uC7A0\uACA8\uC788\uB294 \uB8EC \uC2AC\uB86F\uC785\uB2C8\uB2E4."
  runeSlotUnlockLevelMessage: "\uCE90\uB9AD\uD130 Lv.{0}\uC5D0 \uD574\uAE08\uB418\uB294
