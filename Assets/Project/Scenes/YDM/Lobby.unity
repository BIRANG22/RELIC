  m_Script: {fileID: 11500000, guid: 4124f3539ff6f5d4289f37f274bf8bca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 89042663}
  npcImage: {fileID: 12388811}
  nameText: {fileID: 472956128}
  dialogueText: {fileID: 1353154815}
  nextButton: {fileID: 1339705162}
  nextButtonIndicator: {fileID: 0}
  speakerName: "\uC5F0\uAD6C\uC6D0 \uC5D8\uB9AD"
  tutorialStartBeforeTransitionEnd: 0.15
  charactersPerSecond: 30
  indicatorMoveDistance: 6
  indicatorMoveSpeed: 0.5
  tutorialDisplay: {fileID: 1170293879}
  anchorImage: {fileID: 1160850762}
  fragmentGroup: {fileID: 906308850}
  fragmentImages:
  - {fileID: 16871967}
  - {fileID: 1190707468}
  - {fileID: 1195802682}
  anchorVfxRoot: {fileID: 0}
  anchorVfxRenderTextureWidth: 512
  anchorVfxRenderTextureHeight: 512
  anchorVfxRenderCameraOrthographicSize: 3
  anchorVfxProxySize: {x: 400, y: 400}
  anchorVfxProxyAnchoredPosition: {x: 0, y: 0}
  anchorVfxRenderVfxLocalPosition: {x: 0, y: 0, z: 0}
  anchorVfxProxyMaterialTemplate: {fileID: 0}
  introDialogue:
  - "\uB4DC\uB514\uC5B4 \uBAA8\uB450 \uB3C4\uCC29\uD558\uC168\uAD70\uC694. \uAE30\uB2E4\uB9AC\uACE0
    \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uC6B0\uC120, \uC774 \uADC0\uD658 \uC575\uCEE4\uB97C \uBC1B\uC544 \uC8FC\uC138\uC694."
  - "\uAC70\uC810\uACFC\uC758 \uC575\uCEE4\uB9C1\uC740 \uC774\uBBF8 \uB9C8\uCCD0
    \uB450\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uD0D0\uC0AC \uC911 \uBAA8\uB450\uAC00 \uC4F0\uB7EC\uC9C0\uB354\uB77C\uB3C4,\n\uC774
    \uC575\uCEE4\uAC00 \uC5EC\uB7EC\uBD84\uC744 \uB2E4\uC2DC \uAC70\uC810\uC73C\uB85C
    \uC774\uB04C\uC5B4 \uC904 \uAC81\uB2C8\uB2E4."
  - "\uADF8\uB9AC\uACE0 \uC774\uAC83\uB4E4\uC740 \uC81C\uAC00 \uC900\uBE44\uD574
    \uB454 \uD30C\uD3B8\uC785\uB2C8\uB2E4."
  - "\uD30C\uD3B8\uC744 \uC801\uC808\uD788 \uD65C\uC6A9\uD558\uBA74\n\uC5EC\uB7EC\uBD84\uC758
    \uB2A5\uB825\uC744 \uB354\uC6B1 \uB04C\uC5B4\uC62C\uB9B4 \uC218 \uC788\uC744
    \uAC81\uB2C8\uB2E4."
  - "\uC900\uBE44\uB97C \uB9C8\uCE5C \uB4A4, \uB2E4\uC2DC \uC800\uC5D0\uAC8C \uB9D0\uC744
    \uAC78\uC5B4 \uC8FC\uC138\uC694."
  anchorShowStartIndex: 1
  anchorShowEndIndex: 3
  fragmentShowStartIndex: 4
  fragmentShowEndIndex: 5
  firstExpeditionDialogue:
  - "\uC900\uBE44\uB97C \uB9C8\uCE58\uC168\uAD70\uC694."
  - "\uCCAB \uD0D0\uC0AC\uC9C0\uB294 \uB85C\uB370\uB978 \uD3D0\uD5C8\uC785\uB2C8\uB2E4."
  - "\uADF8\uACF3\uC5D0\uC11C \uC5F0\uAD6C\uC5D0 \uD544\uC694\uD55C \uC7AC\uB8CC\uB97C
    \uD655\uBCF4\uD574 \uC640 \uC8FC\uC138\uC694."
  starterRuneIds:
  - Rune_06
  - Rune_07
  - Rune_08
